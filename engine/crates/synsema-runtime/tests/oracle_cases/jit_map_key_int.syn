-- v0.6.63: el contador con clave entera corre en nativo y usa la misma clave textual.
let counts be {}
each i in range(0, 20000)
    set counts[i % 3] to get(counts, i % 3, 0) + 1
print(counts["1"], counts[1], length(keys(counts)))

-- Claves negativas y booleanas, y copia al escribir un mapa compartido.
let m be {"1": 4, "-7": 8, "true": 3, "nothing": 5}
let alias be m
set m[1] to m[1] + 1
print(m["1"], alias[1], m[-7], get(m, true, 0), get(m, nothing, 0), keys(m))

-- La task recibe el mismo valor, pero su escritura copia antes de cambiarlo.
task bump(xs)
    each i in range(0, 2000)
        set xs[0] to xs[0] + 1
    give xs
let original be [10, "keep"]
let changed be bump(original)
print(changed[0], original[0])

-- Una local sobrevive al while; el each de preparación usa otro nombre.
task local_count(n)
    let xs be []
    each fill_i in range(0, 20)
        set xs to append(xs, 0)
    let i be 0
    while i < n
        set xs[i % 20] to xs[i % 20] + 1
        set i to i + 1
    give xs
let counted be local_count(2000)
print(counted[7], length(counted))
