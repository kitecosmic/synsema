-- F4.7b: un índice fuera de rango a mitad de un bucle nativo que lee una lista: el nativo sale antes
-- de la instrucción y la VM da el error de siempre, con su ubicación (y `steps()` hasta ahí).
let xs be range(0, 20)
let s be 0
each i in range(0, 200)
    when i == 150
        print(steps())
    set s to s + xs[i % 20 + i // 149]
print(s)
