+/// bytes: whether it has a character with a shorter equivalent. When it cannot be told (text
+/// that is not UTF-8, no case folding tables), yes.
+fn text_can_shrink(text: &[u8]) -> bool {
+    if text.is_ascii() {
+        return false;
+    }
+    let Ok(text) = core::str::from_utf8(text) else {
