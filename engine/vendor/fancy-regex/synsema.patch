+/// Synsema: what an instruction takes in memory, in bytes: the instruction itself and the text
+/// or the ranges it owns. The regex or the DFA of an instruction that searches is not here: two
+/// instructions can share one, and it is counted where it is built
+/// (`VMBuilder::new_meta_cache`, `VMBuilder::new_lazy_cache`).
+fn insn_bytes(insn: &Insn) -> usize {
+    use core::mem::size_of;
+    let owned = match insn {
+        Insn::Lit(s) => s.len(),
+        Insn::LitBytes(bytes) => bytes.len(),
+        Insn::LitCasei(lit) => lit.heap_bytes(),
+        Insn::CharClass(CharClassMatcher::Codepoint { ranges, name }) => {
+            ranges.len() * size_of::<(char, char)>() + name.as_ref().map_or(0, |n| n.len())
+        }
+        Insn::CharClass(CharClassMatcher::Byte { ranges, name }) => {
+            ranges.len() * size_of::<(u8, u8)>() + name.as_ref().map_or(0, |n| n.len())
+        }
+        Insn::Delegate(d) | Insn::AbsentRepeater(d) => d.pattern.len(),
+        Insn::Seek(s) => s.pattern.len(),
+        #[cfg(feature = "variable-lookbehinds")]
+        Insn::BackwardsDelegate(d) => d.pattern.len(),
+        #[cfg(feature = "variable-lookbehinds")]
+        Insn::HardVariableLookbehind(d) => d.pattern.len(),
+        _ => 0,
+    };
+    size_of::<Insn>().saturating_add(owned)
+}
