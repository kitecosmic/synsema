+/// Synsema: what the search cache of `re` holds whatever the text is, in bytes; `None` when
+/// that is more than `room`.
+///
+/// It is the cache with everything `regex_automata` puts in it for this regex, counted
+/// (`Cache::memory_usage`). A cache as `create_cache` returns it does not have the cache of the
+/// PikeVM yet: the meta engine makes that one the first time the PikeVM runs. `Cache::reset`
+/// makes it, so the cache counted here is one that was made and reset.
+///
+/// Almost all of it grows with the size of the regex, which is already built and counted. The
+/// part that does not is the table of the PikeVM: one row of capture slots for every state of
+/// the NFA, twice, so with G groups it grows with G times the states (2,000 empty groups: 270
+/// MB). That part is worked out before the cache is made, so that a regex whose table does not
+/// fit is an error and not an allocation: first from what the regex takes (every state is in
+/// there, so it cannot have more states than that), and only when that bound does not fit, from
+/// the NFA built again to count its states.
+pub(crate) fn fresh_meta_cache_bytes(
+    re: &RaRegex,
+    source: EngineSource<'_>,
+    options: &CompileOptions,
+    room: usize,
+) -> Option<usize> {
+    use core::mem::size_of;
+    use regex_automata::nfa::thompson;
+    use regex_automata::util::primitives::NonMaxUsize;
+
+    let slot_len = re.group_info().slot_len();
+    let fits = |states: usize| {
+        states
+            .checked_mul(slot_len)
+            .and_then(|slots| slots.checked_add(slot_len))
+            .and_then(|slots| slots.checked_mul(2 * size_of::<Option<NonMaxUsize>>()))
+            .map_or(false, |bytes| bytes <= room)
+    };
+    let at_most = re.memory_usage() / size_of::<thompson::State>();
+    if !fits(at_most) && !fits(nfa_states(re, &source, options)?) {
+        return None;
+    }
+    let mut cache = re.create_cache();
+    cache.reset(re);
+    let bytes = cache.memory_usage();
+    (bytes <= room).then_some(bytes)
 }
 
