+/// Synsema: how many states the forward NFA of `re` has, by building it again from the same
+/// source with the same configuration (`meta::Regex` does not give its NFA).
+fn nfa_states(re: &RaRegex, source: &EngineSource<'_>, options: &CompileOptions) -> Option<usize> {
+    use regex_automata::nfa::thompson;
+    use regex_automata::util::syntax;
+
+    let config = re.get_config();
+    let thompson_config = thompson::Config::new()
+        .utf8(config.get_utf8_empty())
+        .nfa_size_limit(config.get_nfa_size_limit())
+        .shrink(false)
+        .which_captures(config.get_which_captures());
+    let mut compiler = thompson::Compiler::new();
+    compiler.configure(thompson_config);
+    let nfa = match source {
+        EngineSource::Hir(hir) => compiler.build_from_hir(hir).ok()?,
+        EngineSource::Pattern(pattern) => {
+            let utf8 = matches!(options.bytes_mode, BytesMode::Unicode);
+            let syntax = syntax::Config::new().utf8(utf8).unicode(options.unicode);
+            let hir = syntax::parse_with(pattern, &syntax).ok()?;
+            compiler.build_from_hir(&hir).ok()?
+        }
+    };
+    Some(nfa.states().len())
+}
