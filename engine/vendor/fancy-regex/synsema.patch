+/// Synsema: `analyze` for a tree that is about to be compiled, with the options it is compiled
+/// with (what the linear engine gets is built from them: `HirCtx::from`). On top of what
+/// `analyze` says, an alternation that the linear engine would read in another order than it is
+/// written in is hard, and so is everything that contains it.
+///
+/// `regex_syntax` takes out of an alternation what all its branches start with, whatever it is
+/// (`lift_common_prefix`: `x*a|x*b` becomes `x*(?:a|b)`). When that beginning can end in more
+/// than one place, the factored form tries the ways in another order: `a?a|a?b` on `ab` is `a`
+/// as written (the first branch, with its `a?` empty), which is what Perl, Python and the VM
+/// give, and `ab` once factored. Where an alternation runs depends on what is around it, so
+/// the match changed with things that do not change what the pattern matches.
+///
+/// What `regex_syntax` makes of an alternation is not worked out from its shape: it is built,
+/// with the function that builds what the linear engine gets (`expr_to_hir`), and looked at.
+/// Working it out was a copy of the rules of another crate, and three audits in a row found a
+/// case the copy did not have (a count of something empty, a `{0}` of something unbounded,
+/// what is left of a `{0}` in the whole pattern).
+pub(crate) fn analyze_for_linear<'a>(
+    tree: &'a ExprTree,
+    ctx: AnalyzeContext,
+    options: &RegexOptions,
+) -> Result<Info<'a>> {
+    let mut info = analyze(tree, ctx)?;
+    Linear::new(options).settle(&mut info);
+    Ok(info)
+}
+
+/// Synsema: what the linear engine would be built with. An alternation reaches it in two ways,
+/// and they do not always build the same thing: with the whole pattern, where what is left of a
+/// `{0}` is kept for its groups (and is not always nothing: `(?:a?b?){0}` is two empty
+/// repetitions there), and in a piece that the VM hands over, where a `{0}` is nothing. (A
+/// DEFINE block is the other thing the two build differently: the places of its groups.) One
+/// translation context for each, with what `Regex::new_options` and `DelegateBuilder` give
+/// theirs, and each noting the alternations it builds that come out in the order they are
+/// written in.
+struct Linear {
+    whole: HirCtx,
+    piece: HirCtx,
+}
+
+impl Linear {
+    fn new(options: &RegexOptions) -> Self {
+        let mut whole = HirCtx::from(options);
+        whole.enable_preserve_zero_rep_captures();
+        whole.note_alternations();
+        let mut piece = HirCtx::from(options);
+        piece.note_alternations();
+        Linear { whole, piece }
+    }
+
+    /// Goes down to everything that can go to the linear engine: the largest parts of the tree
+    /// with nothing hard in them. Each is translated once (twice when the two ways differ in
+    /// it), so every node is translated a fixed number of times whatever the nesting, and then
+    /// its alternations are marked.
+    fn settle(&mut self, info: &mut Info<'_>) {
+        if info.hard {
+            for child in &mut info.children {
+                self.settle(child);
+            }
+            return;
+        }
+        // There is nothing to ask where there is no alternation, which is most pieces: those
+        // are not translated here at all.
+        if !has_alternation(info) {
+            return;
+        }
+        // Translated or not: an alternation that was not reached is not noted, and `mark` takes
+        // the ones that are not noted.
+        let places = self.piece.places();
+        let _ = expr_to_hir(info.expr, &mut self.piece);
+        // The two ways differ only at a `{0}` and at a DEFINE block (`HirCtx::places`): with
+        // neither in this part, the other translation would be this one again.
+        let both = self.piece.places() != places;
+        if both {
+            let _ = expr_to_hir(info.expr, &mut self.whole);
+        }
+        self.mark(info, both);
+    }
+
+    /// In a part of the tree that was just translated: marks as hard every alternation that is
+    /// not noted as written (in both ways, when both were translated), and whatever contains
+    /// one. Says whether it marked anything in `info`.
+    fn mark(&mut self, info: &mut Info<'_>, both: bool) -> bool {
+        // What a DEFINE block defines is not part of what was translated (the block is nothing
+        // where it stands): it is what the VM compiles when a definition is called, so it is
+        // settled on its own. And it marks nothing above it: the block is not hard whatever it
+        // holds, as in `analyze`.
+        if let Expr::DefineGroup { .. } = *info.expr {
+            for child in &mut info.children {
+                self.settle(child);
+            }
+            return false;
+        }
+        let mut marked = false;
+        for child in &mut info.children {
+            marked |= self.mark(child, both);
+        }
+        if matches!(*info.expr, Expr::Alt(_))
+            && !(self.piece.as_written(info.expr) && (!both || self.whole.as_written(info.expr)))
+        {
+            marked = true;
+        }
+        if marked {
+            info.hard = true;
+        }
+        marked
+    }
+}
+
+/// Synsema: whether there is an alternation in this part of the tree.
+fn has_alternation(info: &Info<'_>) -> bool {
+    matches!(*info.expr, Expr::Alt(_)) || info.children.iter().any(has_alternation)
+}
