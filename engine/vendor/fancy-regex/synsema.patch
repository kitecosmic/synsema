+        HirKind::Class(_) => false,
+        // A fixed count of something that ends in one place.
+        HirKind::Repetition(rep) if rep.max == Some(rep.min) => more_than_one_end(&rep.sub),
+        HirKind::Concat(parts) => parts.iter().any(more_than_one_end),
+        // A capture group is not here: no two have the same number, so none is ever in what
+        // two branches have in common.
