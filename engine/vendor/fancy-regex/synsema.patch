+/// Synsema: the characters that have, under simple case folding, an equivalent that takes fewer
+/// bytes in UTF-8 (`ſ` and `s`, the Kelvin sign and `k`, `ẞ` and `ß`…), as sorted ranges; `None`
+/// when the case folding tables are not there. For each length in UTF-8, they are what the
+/// shorter characters fold to among the characters of that length.
+fn build_shrinking_chars() -> Option<Box<[(char, char)]>> {
+    use regex_syntax::hir::{ClassUnicode, ClassUnicodeRange};
+
+    // The last character of the shorter lengths, and the characters of the next one.
+    let lengths: [(char, &[(char, char)]); 3] = [
+        ('\u{7F}', &[('\u{80}', '\u{7FF}')]),
+        ('\u{7FF}', &[('\u{800}', '\u{D7FF}'), ('\u{E000}', '\u{FFFF}')]),
+        ('\u{FFFF}', &[('\u{10000}', '\u{10FFFF}')]),
+    ];
+    let mut out = Vec::new();
+    for (last_shorter, longer) in lengths {
+        let mut folded = ClassUnicode::new([ClassUnicodeRange::new('\0', last_shorter)]);
+        folded.try_case_fold_simple().ok()?;
+        folded.intersect(&ClassUnicode::new(
+            longer.iter().map(|&(a, b)| ClassUnicodeRange::new(a, b)),
+        ));
+        out.extend(folded.ranges().iter().map(|r| (r.start(), r.end())));
+    }
+    Some(out.into())
+}
