-- v0.6.63: el bucle real de fusionar del BPE, repetido para amortizar la compilación.
-- Complementa j_while_and (una sola llamada): ambos extremos importan.
task fusionar(ids, a, b, nuevo)
    let salida be []
    let i be 0
    let n be length(ids)
    while i < n
        when i < n - 1 and ids[i] == a and ids[i + 1] == b
            set salida to append(salida, nuevo)
            set i to i + 2
        otherwise
            set salida to append(salida, ids[i])
            set i to i + 1
    give salida
let ids be range(0, 4000)
let total be 0
each pass in range(0, 100)
    set total to total + length(fusionar(ids, 300, 301, 999))
print(total)
