-- Vela client in Synsema — everything OUTSIDE the enclave that a Vela app needs, and that
-- Horizen's `novaw` wallet only does for its own payment app: make the P-521 key, register it
-- (AssociateKey with a privacy seed), upload a `.wasm` and deploy it (with or without a trigger
-- contract), submit PROCESS / DEANONYMIZATION requests with the payload encrypted for the
-- Executor, wait for completion through the subgraph, and decrypt your events. Any payload, any app.
--
--   The public devnet (no Docker):
--   Synsema run vela_client.syn -- devnet [host]                     a token of your own from devnet.synsema.app, written to .env
--   Synsema run vela_client.syn -- allow-token <address>             TokenAllowlist.addAllowedToken with the signing key (the admin: Anvil #0 on a devnet)
--   Synsema run vela_client.syn -- allow-authority <appId> <address> DefaultAuthority.addAllowedAuthority — an auditor for your app
--   Synsema run vela_client.syn -- keys                          a fresh P-521 pair, printed for .env
--   Synsema run vela_client.syn -- address                       the signing address (VELA_SECP_KEY)
--   Synsema run vela_client.syn -- tee                           the Executor's P-521 key, read on-chain
--   Synsema run vela_client.syn -- tee --verify [--pcr0 <hex>]   the Nitro attestation behind that key, verified here, not trusted from the contract
--   Synsema run vela_client.syn -- governance [--json]           who controls what: owner, PCR0 and its history, authorities, fees
--   Synsema run vela_client.syn -- deploy <app.wasm> [params-json|-] [trigger-address]
--   Synsema run vela_client.syn -- register                      AssociateKey: your key + encrypted seed
--   Synsema run vela_client.syn -- deposit <amount> [token]      ETH (wei) or an allowlisted ERC-20 into the app (the guest's `deposit`)
--   Synsema run vela_client.syn -- send '<json>' [wei]           PROCESS (payload encrypted; optional deposit with it)
--   Synsema run vela_client.syn -- report '<json>'               DEANONYMIZATION (the caller must be an allowed authority); prints the decrypted report
--   Synsema run vela_client.syn -- report-download <reportId>    fetch + decrypt an earlier report from the authority service
--   Synsema run vela_client.syn -- events [n]                    your last n events, decrypted
--   Synsema run vela_client.syn -- app-events [n]                the app's public events (subtype + data)
--   Synsema run vela_client.syn -- status <requestId>
--   facilitator (the user signs, VELA_SECP_KEY pays gas and fee; the user needs no ETH):
--   Synsema run vela_client.syn -- user                          the user's address (VELA_USER_KEY)
--   Synsema run vela_client.syn -- register-for                  AssociateKey for the user, submitted by the facilitator
--   Synsema run vela_client.syn -- send-for '<json>' [amount token]   PROCESS for the user; an ERC-20 deposit rides on an EIP-2612 permit
--   Synsema run vela_client.syn -- events-for [n]                the user's events, decrypted
--   `--verified` on register / send / report / register-for / send-for: run `tee --verify` first and
--   encrypt only if it passes (the payload never leaves the machine for an unattested key).
--
-- Config comes from .env (copy .env.example): VELA_RPC_URL, VELA_PROCESSOR, VELA_TEE_AUTHENTICATOR,
-- VELA_AUTHORITY_URL, VELA_SUBGRAPH_URL, VELA_APP_ID, VELA_MAX_FEE (wei), VELA_SECP_KEY (hex),
-- VELA_P521_KEY (hex, 66 bytes), VELA_P521_PUB (hex, 133 bytes, uncompressed), and for the
-- facilitator commands VELA_USER_KEY (the user's secp256k1 key, hex). `governance` and `tee --verify`
-- Read the contracts' logs from VELA_FROM_BLOCK (default 0; set it near the deployment block on an
-- RPC that caps eth_getLogs ranges).
--
-- Wire formats, read from HorizenOfficial/vela v0.2.0 (`pkg/crypto/cipher.go`, `pkg/blockchain/client.go`,
-- `contracts/ProcessorEndpoint.sol`) and the vela-nova wallet (`cmd/seed.go`, `cmd/deployapp.go`):
--   payload   = nonce(12) ‖ AES-256-GCM(key, plaintext), key = HKDF-SHA256(ECDH-P-521 shared X, no salt, no info, 32)
--   register  = P-521 public (133 bytes) ‖ nonce(12) ‖ AES-GCM(seed); seed = secp256k1_sign(keccak256("subtype-key-v1"))
--   subtypes  = HMAC-SHA256(seed, byte(i)), i = 1..50: the Executor stamps one of them on each of your events
--   deploy    = POST multipart `wasm` to <authority>/deploy/upload → submitDeployRequest(0, JSON descriptor)
--   requestId = topic 2 of RequestSubmitted; a deploy's applicationId = topic 1 of DeployRequestSubmitted
intent: "vela client: keys, register, deploy, submit, wait, decrypt events"

-- The hosts the client may talk to: the local starter kit, and the shared devnet. Add yours here.
require net("localhost")
require net("127.0.0.1")
require net("devnet.synsema.app")
require env("VELA_*")
require secret("VELA_*")
require sign("VELA_SECP_KEY")
require sign("VELA_USER_KEY")
require random
require time
require file.read("*")
require file.write(".env")
require reveal("ecdh_keypair.private")

let ETH be "0x0000000000000000000000000000000000000000"
let PROTOCOL_VERSION be 0
let PROCESS be 1
let DEANONYMIZATION be 2
let ASSOCIATE_KEY be 3
let SIG_REQUEST_SUBMITTED be "0x" + decode(keccak256("RequestSubmitted(uint64,bytes32,address,address)"), "hex")
let SIG_DEPLOY_SUBMITTED be "0x" + decode(keccak256("DeployRequestSubmitted(uint64,bytes32,address)"), "hex")
-- TeeAuthenticator (ITeeAuthenticatorAdmin.sol) and DefaultAuthority (IDefaultAuthorityChecker.sol) events
let SIG_TEE_UPDATE be "0x" + decode(keccak256("TeeUpdate(address,address,bytes,bytes)"), "hex")
let SIG_PCR0_UPDATE be "0x" + decode(keccak256("PcrZeroUpdate(bytes,bytes)"), "hex")
let SIG_ADDED_AUTHORITY be "0x" + decode(keccak256("AddedAuthority(uint256,address)"), "hex")
let SIG_REMOVED_AUTHORITY be "0x" + decode(keccak256("RemovedAuthority(uint256,address)"), "hex")
-- The owner's transactions whose calldata `tee --verify` and `governance` read back
let SEL_UPDATE_TEE be abi_selector("updateTee(bytes)")
let SEL_UPDATE_TEE_STEP1 be abi_selector("updateTeeStep1(bytes)")
let SEL_UPDATE_TEE_STEP4 be abi_selector("updateTeeStep4()")
let SEL_UPDATE_PCR0 be abi_selector("updatePcr0(bytes)")

-- ---- small helpers ----

-- Decimal text → exact integer (`number()` is a float and loses digits above 2^53).
task int_of(t)
    let n be 0
    each ch in split(trim(t), "")
        set n to n * 10 + floor(number(ch))
    give n

task hex_bytes(h)
    let s be when starts_with(h, "0x") then slice(h, 2, length(h)) otherwise h
    give bytes(s, "hex")

task hex_of(b)
    give "0x" + decode(b, "hex")

-- Lowercase hex without the 0x: the form two hashes, keys or addresses are compared in
task hex_plain(h)
    let l be lower(h)
    give when starts_with(l, "0x") then slice(l, 2, length(l)) otherwise l

-- A map's value, or nothing when the key is not there (a section the chain did not give us)
task field(m, k)
    give when contains(m, k) then m[k] otherwise nothing

-- JSON-RPC quantities are hex text without leading zeros ("0x1a", "0x0"); `evm_rpc` passes them
-- through untouched in both directions.
task hex_quantity(n)
    let h be decode(int_to_bytes(n), "hex")
    while length(h) > 1 and starts_with(h, "0")
        set h to slice(h, 1, length(h))
    give when h == "" then "0x0" otherwise "0x" + h

task quantity_of(h)
    let s be hex_plain(h)
    when length(s) % 2 == 1
        set s to "0" + s
    give bytes_to_int(bytes(s, "hex"))

task cfg()
    give {
        "rpc": env("VELA_RPC_URL", "http://localhost:8545"),
        "processor": env("VELA_PROCESSOR", ""),
        "tee_auth": env("VELA_TEE_AUTHENTICATOR", ""),
        "authority": env("VELA_AUTHORITY_URL", "http://localhost:8081"),
        "subgraph": env("VELA_SUBGRAPH_URL", "http://localhost:8000/subgraphs/name/hcce"),
        "app_id": env("VELA_APP_ID", ""),
        "max_fee": env("VELA_MAX_FEE", "100")
    }

task need(c, key, hint)
    when c[key] == ""
        raise("set " + hint + " in .env")
    give c[key]

-- ---- keys ----

task secp_key()
    give secret("VELA_SECP_KEY")

-- `ecdh_shared_secret` takes the private scalar as bytes: the hex in .env is decoded and sealed.
task p521_key()
    let h be env("VELA_P521_KEY", "")
    when h == ""
        raise("set VELA_P521_KEY in .env (run `keys` to make one)")
    give as_secret(hex_bytes(h), "VELA_P521_KEY")

task p521_public()
    let h be env("VELA_P521_PUB", "")
    when h == ""
        raise("set VELA_P521_PUB in .env (run `keys` to make one)")
    let b be hex_bytes(h)
    when length(b) != 133 or b[0] != 4
        raise("VELA_P521_PUB must be the uncompressed P-521 public key: 0x04 + X + Y (133 bytes)")
    give b

task me()
    give evm_address(secp_key())

-- The Executor's communication key, published on-chain by the TEE authenticator.
task tee_public_key(c)
    let raw be evm_call(c["rpc"], {"to": need(c, "tee_auth", "VELA_TEE_AUTHENTICATOR"), "data": abi_encode("getPubSecp521r1()", [])})
    let pub be abi_decode("bytes", raw)[0]
    when length(pub) != 133
        raise("the TEE authenticator returned " + text(length(pub)) + " bytes, not a 133-byte P-521 key")
    give pub

-- ---- reading contracts and their logs ----

task call_typed(c, dest, abi_type, signature, values)
    give abi_decode(abi_type, evm_call(c["rpc"], {"to": dest, "data": abi_encode(signature, values)}))[0]

-- A view this deployment may not have (v0.2.0 vs dev, a mock vs the real contract): its value, or
-- `nothing` when the call reverts or returns nothing decodable.
task call_optional(c, dest, abi_type, signature, values)
    let out be nothing
    try
        set out to call_typed(c, dest, abi_type, signature, values)
    recover err
        set out to nothing
    give out

task from_block(c)
    give hex_quantity(int_of(env("VELA_FROM_BLOCK", "0")))

-- Eth_getLogs of one contract from VELA_FROM_BLOCK, oldest first (as the node returns them).
task contract_logs(c, address, topics)
    give evm_rpc(c["rpc"], "eth_getLogs", [{"address": address, "fromBlock": from_block(c), "toBlock": "latest", "topics": topics}])

task transaction(c, hash)
    let tx be evm_rpc(c["rpc"], "eth_getTransactionByHash", [hash])
    when tx == nothing
        raise("transaction " + text(hash) + " is unknown to " + c["rpc"])
    give tx

-- Block · 10^5 + logIndex: one number that orders logs the way the chain does
task log_order(entry)
    give quantity_of(entry["blockNumber"]) * 100000 + quantity_of(entry["logIndex"])

-- An `address indexed` topic is the address left-padded to 32 bytes
task address_of_topic(topic)
    let h be hex_plain(topic)
    give "0x" + slice(h, length(h) - 40, length(h))

-- ---- the Executor's cipher (pkg/crypto/cipher.go) ----

task derive_key(own_private, peer_public)
    let shared be ecdh_shared_secret(own_private, peer_public, "P-521")
    give hkdf_sha256(shared, bytes(""), bytes(""), 32)

task seal(key, plaintext)
    let nonce be random_bytes(12)
    give nonce + aes_gcm_encrypt(key, nonce, plaintext)

task open(key, blob)
    when length(blob) < 28
        raise("ciphertext too short (" + text(length(blob)) + " bytes)")
    give aes_gcm_decrypt(key, slice(blob, 0, 12), slice(blob, 12, length(blob)))

-- Every byte encrypted for the Executor goes through here. With `--verified` the key is used only
-- after `tee --verify` passed in this same run; without it, the contract's word is taken as today.
task executor_key(c, verified)
    when verified
        let v be verify_tee(c, nothing)
        print("tee --verify: OK (pcr0 " + v["attestation"]["measurements"]["pcr0"] + ", module " + text(v["attestation"]["module_id"]) + ")")
    give tee_public_key(c)

task seal_for_executor(c, plaintext, verified)
    give seal(derive_key(p521_key(), executor_key(c, verified)), plaintext)

-- ---- privacy seed and the 50 subtypes (vela-nova cmd/seed.go, vela-common-go/subtypes) ----

task seed_of(secp)
    give secp256k1_sign(keccak256("subtype-key-v1"), secp)

task subtypes(seed)
    let out be []
    each i in range(1, 51)
        set out to append(out, hex(hmac(as_secret(bytes([i]), "subtype-index"), as_secret(seed, "subtype-seed"))))
    give out

-- ---- transactions ----

task send_tx(c, dest, value, calldata)
    let url be c["rpc"]
    let sender be me()
    let gas be evm_estimate_gas(url, {"from": sender, "to": dest, "value": value, "data": calldata})
    let fees be evm_fee_history(url)
    let tx be evm_tx({
        "chain_id": evm_chain_id(url),
        "nonce": evm_nonce(url, sender),
        "to": dest,
        "value": value,
        "gas": gas + floor(gas / 4),
        "max_fee": fees["base_fee"] * 2 + fees["priority"] + 1,
        "max_priority": fees["priority"] + 1,
        "data": calldata
    })
    let sig be secp256k1_sign(tx["digest"], secp_key())
    let hash be evm_send(url, evm_tx_raw(tx, sig))
    let receipt be evm_wait(url, hash, 1, 120)
    when receipt == nothing
        raise("transaction " + hash + " was not mined within 120 s")
    when receipt["status"] != 1
        raise("transaction " + hash + " reverted")
    give receipt

task find_log(receipt, signature)
    each entry in receipt["logs"]
        when length(entry["topics"]) > 0 and lower(entry["topics"][0]) == signature
            give entry
    give nothing

task request_id_of(receipt)
    let entry be find_log(receipt, SIG_REQUEST_SUBMITTED)
    when entry == nothing
        raise("RequestSubmitted not found in the receipt logs")
    give lower(entry["topics"][2])

task deploy_ids_of(receipt)
    let entry be find_log(receipt, SIG_DEPLOY_SUBMITTED)
    when entry == nothing
        raise("DeployRequestSubmitted not found in the receipt logs")
    let app_id be bytes_to_int(hex_bytes(entry["topics"][1]))
    give {"app_id": app_id, "request_id": hex_of(slice(entry["data"], 0, 32))}

-- submitRequest(protocolVersion, applicationId, requestType, payload, tokenAddress, assetAmount, maxFeeValue)
-- payable: ETH requests send assetAmount + maxFeeValue; ERC-20 ones send maxFeeValue and pull the token.
task submit(c, request_type, payload, token, asset_amount)
    let app_id be int_of(need(c, "app_id", "VELA_APP_ID"))
    let max_fee be int_of(c["max_fee"])
    let calldata be abi_encode("submitRequest(uint8,uint64,uint8,bytes,address,uint256,uint256)", [PROTOCOL_VERSION, app_id, request_type, payload, token, asset_amount, max_fee])
    let value be when token == ETH then asset_amount + max_fee otherwise max_fee
    let receipt be send_tx(c, need(c, "processor", "VELA_PROCESSOR"), value, calldata)
    give request_id_of(receipt)

-- ERC-20: allow the ProcessorEndpoint to pull `amount` of `token` from us.
task approve(c, token, amount)
    let receipt be send_tx(c, token, 0, abi_encode("approve(address,uint256)", [need(c, "processor", "VELA_PROCESSOR"), amount]))
    print("approved " + text(amount) + " of " + token + " (tx " + text(receipt["transactionHash"]) + ")")

-- ---- deploy: upload the artifact, then the on-chain descriptor (vela-nova cmd/deployapp.go) ----

task upload_wasm(c, path)
    let wasm be read_file_bytes(path)
    let sha be decode(sha256(wasm), "hex")
    let m be multipart_encode([{"name": "wasm", "filename": "app.wasm", "bytes": wasm, "content_type": "application/wasm"}])
    let r be http_post(c["authority"] + "/deploy/upload", m["body"], {"Content-Type": m["content_type"]})
    when not r["ok"]
        raise("upload failed: HTTP " + text(r["status"]) + " " + r["body"])
    let j be r["json"]
    when j["wasmSha256"] != sha
        raise("upload hash mismatch: local " + sha + ", authority " + text(j["wasmSha256"]))
    give j

task deploy(c, path, params, trigger)
    let up be upload_wasm(c, path)
    let descriptor be {"mode": "artifact_ref", "artifactId": up["artifactId"], "wasmSha256": up["wasmSha256"]}
    when params != nothing
        set descriptor["constructorParams"] to params
    let payload be bytes(json_encode(descriptor))
    let calldata be when trigger == nothing then abi_encode("submitDeployRequest(uint8,bytes)", [PROTOCOL_VERSION, payload]) otherwise abi_encode("submitDeployRequestWithTrigger(uint8,bytes,address)", [PROTOCOL_VERSION, payload, trigger])
    let receipt be send_tx(c, need(c, "processor", "VELA_PROCESSOR"), int_of(c["max_fee"]), calldata)
    give deploy_ids_of(receipt)

-- ---- the subgraph ----

task graphql(c, query, variables)
    let r be http_post(c["subgraph"], {"query": query, "variables": variables})
    when not r["ok"]
        raise("subgraph: HTTP " + text(r["status"]) + " " + r["body"])
    let j be r["json"]
    when contains(j, "errors") and j["errors"] != nothing and length(j["errors"]) > 0
        raise("subgraph: " + json_encode(j["errors"]))
    give j["data"]

task completion(c, request_id, is_deploy)
    let entity be when is_deploy then "deployRequestCompleteds" otherwise "requestCompleteds"
    let q be "query($id: Bytes!) { " + entity + "(where: { requestId: $id }, first: 1) { applicationId requestId status errorCode errorMessage applicationFees blockNumber } }"
    let rows be graphql(c, q, {"id": request_id})[entity]
    when length(rows) == 0
        give nothing
    give rows[0]

-- A failed request, as a message: the error's NAME first. `errorCode` is the ordinal of the
-- contract's ErrorCode enum and Vela v0.3.0 renumbers it (INSUFFICIENT_FUEL 12 → 11), so nothing
-- In this client branches on the number; it is shown as a datum, after the message.
task failure_message(request_id, row)
    let msg be row["errorMessage"]
    when msg == nothing or text(msg) == ""
        set msg to "(no message)"
    give "request " + request_id + " failed: " + text(msg) + " [errorCode " + text(row["errorCode"]) + ", an enum ordinal that differs between Vela versions]"

-- Polls until the Manager finalizes the request on-chain and the subgraph indexes it.
task wait_completed(c, request_id, is_deploy)
    let waited be 0
    while waited < 240
        let row be completion(c, request_id, is_deploy)
        when row != nothing
            when text(row["status"]) != "0"
                raise(failure_message(request_id, row))
            give row
        sleep(2)
        set waited to waited + 2
    raise("timeout waiting for " + request_id + " (240 s)")

task my_events(c, limit)
    let key be derive_key(p521_key(), tee_public_key(c))
    let subs be subtypes(seed_of(secp_key()))
    give fetch_events(c, key, subs, limit)

task fetch_events(c, key, subs, limit)
    let q be "query($app: BigInt!, $subs: [Bytes!]!, $n: Int!) { userEvents(where: { applicationId: $app, eventSubType_in: $subs }, orderBy: sortKey, orderDirection: desc, first: $n) { requestId eventSubType encryptedData blockNumber logIndex } }"
    let rows be graphql(c, q, {"app": need(c, "app_id", "VELA_APP_ID"), "subs": subs, "n": limit})["userEvents"]
    let out be []
    each ev in rows
        let item be {"request_id": ev["requestId"], "block": ev["blockNumber"]}
        try
            let plain be decode(open(key, hex_bytes(ev["encryptedData"])))
            try
                set item["event"] to json_decode(plain)
            recover err
                set item["event"] to plain
        recover err
            set item["error"] to err
        set out to append(out, item)
    give out

task app_events(c, limit)
    let q be "query($app: BigInt!, $n: Int!) { appEvents(where: { applicationId: $app }, orderBy: sortKey, orderDirection: desc, first: $n) { requestId eventSubType data blockNumber logIndex } }"
    let rows be graphql(c, q, {"app": need(c, "app_id", "VELA_APP_ID"), "n": limit})["appEvents"]
    let out be []
    each ev in rows
        set out to append(out, {"request_id": ev["requestId"], "block": ev["blockNumber"], "subtype": ev["eventSubType"], "label": subtype_label(ev["eventSubType"]), "data": ev["data"]})
    give out

-- A subtype that is a short ASCII label padded with zeros (the guest's `subtype: "execute_requested"`)
-- reads back as that label; a hash (an invoice receipt) reads back as `nothing`.
task subtype_label(subtype)
    let b be hex_bytes(subtype)
    let printable be []
    let zeros be 0
    each i in range(length(b))
        let x be b[i]
        when x == 0
            set zeros to zeros + 1
        otherwise when x >= 32 and x <= 126
            set printable to append(printable, x)
    when length(printable) == 0 or length(printable) + zeros != length(b)
        give nothing
    give decode(bytes(printable))

-- ---- facilitator (meta-transactions, ProcessorEndpoint.submitRequestFor) ----
-- the USER signs an EIP-712 RequestAuthorization (domain Vela / version "0" / chainId / the
-- endpoint) and, for an ERC-20 deposit, an EIP-2612 permit; the FACILITATOR (VELA_SECP_KEY)
-- submits the transaction, paying gas and the fee (msg.value = maxFeeValue). The request runs
-- with sender = user. Only ASSOCIATEKEY and PROCESS; the deposit can only be an ERC-20 (permit),
-- never ETH. The user needs no ETH at all.

task user_key()
    give secret("VELA_USER_KEY")

task user_address()
    give evm_address(user_key())

-- OpenZeppelin's ECDSA.recover wants v = 27/28; secp256k1_sign gives the recovery id 0/1 and
-- evm_signature rewrites it. Named sign_eth so it does not shadow the evm_signature builtin's
-- deprecated alias eth_signature.
task sign_eth(digest, key)
    give evm_signature(secp256k1_sign(digest, key))

task authorization_digest(chain_id, processor, user, app_id, request_type, payload, token, asset_amount, nonce, deadline)
    let domain be {"name": "Vela", "version": "0", "chainId": chain_id, "verifyingContract": processor}
    let types be {"RequestAuthorization": [
        {"name": "sender", "type": "address"}, {"name": "protocolVersion", "type": "uint8"},
        {"name": "applicationId", "type": "uint64"}, {"name": "requestType", "type": "uint8"},
        {"name": "payloadHash", "type": "bytes32"}, {"name": "tokenAddress", "type": "address"},
        {"name": "assetAmount", "type": "uint256"}, {"name": "nonce", "type": "uint256"},
        {"name": "deadline", "type": "uint256"}]}
    let message be {"sender": user, "protocolVersion": PROTOCOL_VERSION, "applicationId": app_id, "requestType": request_type, "payloadHash": keccak256(payload), "tokenAddress": token, "assetAmount": asset_amount, "nonce": nonce, "deadline": deadline}
    give eip712_digest(domain, types, "RequestAuthorization", message)

-- EIP-2612 Permit under the token's own domain (name from `name()`, version "1").
task permit_digest(chain_id, token, token_name, owner, spender, value, nonce, deadline)
    let domain be {"name": token_name, "version": "1", "chainId": chain_id, "verifyingContract": token}
    let types be {"Permit": [
        {"name": "owner", "type": "address"}, {"name": "spender", "type": "address"},
        {"name": "value", "type": "uint256"}, {"name": "nonce", "type": "uint256"},
        {"name": "deadline", "type": "uint256"}]}
    give eip712_digest(domain, types, "Permit", {"owner": owner, "spender": spender, "value": value, "nonce": nonce, "deadline": deadline})

-- depositPermit = abi.encode(uint8 v, bytes32 r, bytes32 s): 96 bytes.
task permit_bytes(signature65)
    give int_to_bytes(signature65[64], 32) + slice(signature65, 0, 64)

task call_uint(c, dest, signature, args)
    give abi_decode("uint256", evm_call(c["rpc"], {"to": dest, "data": abi_encode(signature, args)}))[0]

task submit_for(c, request_type, payload, token, asset_amount)
    let user be user_address()
    let processor be need(c, "processor", "VELA_PROCESSOR")
    let app_id be int_of(need(c, "app_id", "VELA_APP_ID"))
    let chain_id be evm_chain_id(c["rpc"])
    let deadline be floor(now()) + 3600
    -- The public mapping's getter: it exists in v0.2.0 and in dev, while getFacilitatorNonce(address)
    -- Is removed in Vela v0.3.0 (CHANGELOG, "Breaking changes")
    let nonce be call_uint(c, processor, "facilitatorNonces(address)", [user])
    let authorization be sign_eth(authorization_digest(chain_id, processor, user, app_id, request_type, payload, token, asset_amount, nonce, deadline), user_key())
    let permit be bytes([])
    when asset_amount > 0
        when token == ETH
            raise("a facilitator deposit must be an ERC-20 (permit); ETH cannot be deposited through submitRequestFor")
        let token_name be abi_decode("string", evm_call(c["rpc"], {"to": token, "data": abi_encode("name()", [])}))[0]
        let token_nonce be call_uint(c, token, "nonces(address)", [user])
        set permit to permit_bytes(sign_eth(permit_digest(chain_id, token, token_name, user, processor, asset_amount, token_nonce, deadline), user_key()))
    let calldata be abi_encode("submitRequestFor(address,uint8,uint64,uint8,bytes,address,uint256,uint256,bytes,bytes)", [user, PROTOCOL_VERSION, app_id, request_type, payload, token, asset_amount, deadline, authorization, permit])
    let receipt be send_tx(c, processor, int_of(c["max_fee"]), calldata)
    give request_id_of(receipt)

-- The user's AssociateKey payload: the shared P-521 pair from .env, the seed signed by the USER's key.
task register_payload_for(c, verified)
    let encrypted_seed be seal_for_executor(c, seed_of(user_key()), verified)
    give p521_public() + encrypted_seed

task events_for(c, limit)
    let key be derive_key(p521_key(), tee_public_key(c))
    let subs be subtypes(seed_of(user_key()))
    give fetch_events(c, key, subs, limit)

-- ---- the deanonymization report, from the authority service (vela-nova app/authority_client.go) ----
-- GET /nonce → sign keccak256("\x19Ethereum Signed Message:\n" ‖ len ‖ chainId(8) ‖ appId(8) ‖ reportId(32) ‖ nonce(32))
-- with the secp256k1 key → POST /getreport → the report, encrypted for the requester's P-521 key.
task download_report(c, report_id)
    let id be when contains(report_id, "_") then split(report_id, "_")[1] otherwise report_id
    let id_hex be when starts_with(id, "0x") then slice(id, 2, length(id)) otherwise id
    when length(id_hex) != 64
        raise("a report id is 32 bytes of hex (optionally prefixed by <appId>_), got " + report_id)
    let app_id be int_of(need(c, "app_id", "VELA_APP_ID"))
    let chain_id be evm_chain_id(c["rpc"])
    let n be http_get(c["authority"] + "/nonce")["json"]
    let msg be int_to_bytes(chain_id, 8) + int_to_bytes(app_id, 8) + bytes(id_hex, "hex") + bytes(n["nonce"], "hex")
    let prefix be bytes([25]) + bytes("Ethereum Signed Message:\n" + text(length(msg)))
    let sig be secp256k1_sign(keccak256(prefix + msg), secp_key())
    let body be {"chain_id": chain_id, "app_id": app_id, "report_id": id_hex, "salt": n["salt"], "nonce": n["nonce"], "timestamp": n["timestamp"], "signature": decode(sig, "hex")}
    let r be http_post(c["authority"] + "/getreport", body)
    when not r["ok"]
        raise("getreport: HTTP " + text(r["status"]) + " " + r["body"])
    let j be r["json"]
    -- The plaintext is {applicationId, requestId, reportDataBytes}: the guest's `report`, base64 inside.
    let envelope be json_decode(decode(open(derive_key(p521_key(), tee_public_key(c)), bytes(j["encryptedReport"], "hex"))))
    let data be decode(bytes(envelope["reportDataBytes"], "base64"), "utf8_lossy")
    let report be nothing
    try
        set report to json_decode(data)
    recover err
        set report to data
    give {"application_id": j["applicationId"], "report_id": j["reportId"], "authority": j["authority"], "report": report}

-- ---- the AssociateKey payload (133 or 226 bytes) ----

task register_payload(c, verified)
    let encrypted_seed be seal_for_executor(c, seed_of(secp_key()), verified)
    when length(encrypted_seed) != 93
        raise("the encrypted seed must be 93 bytes, got " + text(length(encrypted_seed)))
    give p521_public() + encrypted_seed


-- ---- the public devnet: a token by command, allowlists by the admin key ----

-- POST https://devnet.synsema.app/token → the VELA_* lines for a .env, with a fresh token.
task devnet_env(host)
    let r be http_post("https://" + host + "/token", {})
    when not r["ok"]
        raise("devnet: HTTP " + text(r["status"]) + " " + r["body"])
    give r["json"]["env"]

-- Writes or replaces KEY=value lines in a .env file (keeps everything else as it is).
task env_write(path, values)
    let lines be when file_exists(path) then split(read_file(path), "\n") otherwise []
    let seen be {}
    let out be []
    each line in lines
        let key be split(line, "=")[0]
        when contains(values, key)
            set out to append(out, key + "=" + text(values[key]))
            set seen[key] to true
        otherwise
            set out to append(out, line)
    each k in keys(values)
        when not contains(seen, k)
            set out to append(out, k + "=" + text(values[k]))
    write_file(path, join(out, "\n"))

task allow_token(c, token)
    let allowlist be lower(env("VELA_TOKEN_ALLOWLIST", "0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9"))
    give send_tx(c, allowlist, 0, abi_encode("addAllowedToken(address)", [token]))

task allow_authority(c, app_id, authority)
    let registry be lower(env("VELA_DEFAULT_AUTHORITY", "0x5FbDB2315678afecb367f032d93F642f64180aa3"))
    give send_tx(c, registry, 0, abi_encode("addAllowedAuthority(uint256,address)", [app_id, authority]))

-- ---- tee --verify: the attestation behind the Executor's key (TeeAuthenticator.sol) ----
-- `tee` reads getPubSecp521r1() and trusts the contract. The contract accepted that key because
-- the owner sent a Nitro attestation document that a NitroProver verified on-chain against pcr0()
-- (only PCR0 is compared: `_checkAttestationContent`). That document is public calldata:
-- UpdateTee(bytes) carries it whole; the step flow (updateTeeStep1..4, for chains where one
-- verification does not fit in a block) carries it whole in updateTeeStep1(bytes) — steps 2-4
-- take no calldata, the contract keeps the decoded parts in storage and getStep2TotalLength() is
-- just how many step-2 calls the cabundle needs. So the document is always the single `bytes`
-- Argument of one transaction, and we can verify it ourselves.

-- Pure: the `bytes` argument of an updateTee / updateTeeStep1 call, and which one it was
task attestation_of_calldata(input)
    when length(input) < 4
        raise("calldata too short to carry a selector (" + text(length(input)) + " bytes)")
    let selector be slice(input, 0, 4)
    when selector != SEL_UPDATE_TEE and selector != SEL_UPDATE_TEE_STEP1
        raise("not an updateTee(bytes) / updateTeeStep1(bytes) call (selector " + hex_of(selector) + ")")
    give {"document": abi_decode("bytes", slice(input, 4, length(input)))[0], "via": when selector == SEL_UPDATE_TEE then "updateTee" otherwise "updateTeeStep1"}

-- The last TeeUpdate of the authenticator and the transaction that carried its attestation.
task last_attestation(c, tee_auth)
    let logs be contract_logs(c, tee_auth, [SIG_TEE_UPDATE])
    when length(logs) == 0
        raise("no TeeUpdate event from " + tee_auth + " since block " + from_block(c) + " (VELA_FROM_BLOCK too high, or the RPC caps the eth_getLogs range)")
    let last be logs[length(logs) - 1]
    let tx be transaction(c, last["transactionHash"])
    when tx["to"] == nothing
        raise("the last TeeUpdate came from the constructor (deployment tx " + text(last["transactionHash"]) + "): the key was set by the deployer, there is no attestation on-chain")
    let input be hex_bytes(tx["input"])
    when length(input) >= 4 and slice(input, 0, 4) == SEL_UPDATE_TEE_STEP4
        -- The step flow: the document went in with updateTeeStep1 some blocks earlier
        give step1_before(c, tee_auth, quantity_of(last["blockNumber"]), last["transactionHash"])
    let found be attestation_of_calldata(input)
    set found["tx"] to last["transactionHash"]
    set found["block"] to quantity_of(last["blockNumber"])
    give found

-- Walks blocks backwards from `block` for the owner's updateTeeStep1(bytes) to `tee_auth`: one
-- eth_getBlockByNumber per block, at most VELA_SCAN_BLOCKS of them (default 256).
task step1_before(c, tee_auth, block, step4_tx)
    let limit be int_of(env("VELA_SCAN_BLOCKS", "256"))
    let target be lower(tee_auth)
    let n be block
    while n >= 0 and block - n <= limit
        let b be evm_rpc(c["rpc"], "eth_getBlockByNumber", [hex_quantity(n), true])
        each tx in reverse(b["transactions"])
            when tx["to"] != nothing and lower(tx["to"]) == target and tx["hash"] != step4_tx
                let input be hex_bytes(tx["input"])
                when length(input) >= 4 and slice(input, 0, 4) == SEL_UPDATE_TEE_STEP1
                    let found be attestation_of_calldata(input)
                    set found["tx"] to tx["hash"]
                    set found["block"] to n
                    give found
        set n to n - 1
    raise("updateTeeStep4 at block " + text(block) + " but no updateTeeStep1 in the " + text(limit) + " blocks before it (raise VELA_SCAN_BLOCKS)")

-- Pure: the document's public key against getPubSecp521r1(). The contract stores the raw point
-- 0x04 ‖ X ‖ Y (133 bytes); a document may carry the same point raw or as DER
-- subjectPublicKeyInfo, whose BIT STRING ends with those 133 bytes. Gives how it matched, or nothing.
task key_matches(doc_key, onchain)
    when doc_key == nothing or onchain == nothing
        give nothing
    when doc_key == onchain
        give "raw (0x04 ‖ X ‖ Y)"
    when length(doc_key) > 133 and slice(doc_key, length(doc_key) - 133, length(doc_key)) == onchain
        give "DER SubjectPublicKeyInfo"
    give nothing

-- Pure: the checks that bind a verified document to what the chain trusts. `att` is the map
-- attestation_verify gives; raises on the first thing that does not hold.
task bind_attestation(att, onchain_key, signer, pcr0_onchain, expected_pcr0)
    let form be key_matches(att["public_key"], onchain_key)
    when form == nothing
        raise("the attested public key is not getPubSecp521r1(): the chain trusts a key this document does not vouch for")
    when att["user_data"] == nothing or length(att["user_data"]) != 20
        raise("user_data is not a 20-byte address (the Executor's signer)")
    when hex_plain(hex_of(att["user_data"])) != hex_plain(signer)
        raise("user_data " + hex_of(att["user_data"]) + " is not getTeeSigner() " + signer)
    let m be att["measurements"]
    when not contains(m, "pcr0")
        raise("the document has no PCR0 measurement")
    when hex_plain(m["pcr0"]) != hex_plain(pcr0_onchain)
        raise("the document's PCR0 " + m["pcr0"] + " is not the contract's pcr0() " + pcr0_onchain)
    when expected_pcr0 != nothing and hex_plain(m["pcr0"]) != hex_plain(expected_pcr0)
        raise("PCR0 " + m["pcr0"] + " is not the --pcr0 you expect (" + expected_pcr0 + ")")
    give form

-- Tee --verify: the chain says "this key belongs to the Executor"; this checks WHY it says so.
task verify_tee(c, expected_pcr0)
    let tee_auth be need(c, "tee_auth", "VELA_TEE_AUTHENTICATOR")
    let pcr0 be call_optional(c, tee_auth, "bytes", "pcr0()", [])
    when pcr0 == nothing
        raise("this deployment has no attestation to verify: " + tee_auth + " has no pcr0() — a NoAttestationTeeAuthenticator (the starter kit, the public devnet) publishes the Executor's key on the owner's word alone")
    let found be last_attestation(c, tee_auth)
    let att be attestation_verify(found["document"], {"format": "nitro", "now": floor(now())})
    let signer be call_typed(c, tee_auth, "address", "getTeeSigner()", [])
    let form be bind_attestation(att, tee_public_key(c), signer, hex_of(pcr0), expected_pcr0)
    give {"attestation": att, "found": found, "key_form": form, "signer": signer, "pcr0_onchain": hex_of(pcr0)}

task print_verified(v)
    let att be v["attestation"]
    let m be att["measurements"]
    print("verified: the Executor's key was made inside a Nitro enclave running the code the chain pinned")
    print("  module_id    " + text(att["module_id"]))
    each name in ["pcr0", "pcr1", "pcr2"]
        when contains(m, name)
            print("  " + name + "         " + text(m[name]) + (when name == "pcr0" then "  (= TeeAuthenticator.pcr0())" otherwise ""))
    print("  timestamp    " + text(att["timestamp"]) + " (as in the document)")
    print("  public_key   = getPubSecp521r1(), as " + v["key_form"])
    print("  user_data    " + v["signer"] + " (= getTeeSigner(), the Executor's signer)")
    print("  document     " + v["found"]["via"] + " in tx " + text(v["found"]["tx"]) + " at block " + text(v["found"]["block"]))
    print("  chain")
    each cert in att["chain"]
        print("    " + text(cert["subject"]) + "  " + text(cert["not_before"]) + " → " + text(cert["not_after"]))
    print("what this proves: the key came from an enclave whose code measured to that PCR0 (identity of the code).")
    print("what it does not: the document dates from the enclave's start and carries no nonce of ours — not freshness, not that the same enclave is alive now.")

-- ---- governance: what a user can watch, even if not control ----
-- teeAuthenticator: owner() may updatePcr0 (a new enclave image) and updateTee (a new key) —
-- Only PCR0 is compared. AuthorityRegistry: owner() decides which contract answers "is this
-- authority allowed to deanonymize app X"; DefaultAuthority's owner() keeps the allowlist per app.
-- ProcessorEndpoint: ADMIN role sets the fee collector; minFeePerRequest is what every request pays.

-- Pure: updatePcr0(bytes) calldata → the new PCR0 as hex, or nothing when the calldata is not that
-- call (a multisig's, say) or does not hash to the event's `indexed bytes` topic
task pcr0_of_calldata(input, new_hash)
    when length(input) < 4 or slice(input, 0, 4) != SEL_UPDATE_PCR0
        give nothing
    let value be abi_decode("bytes", slice(input, 4, length(input)))[0]
    when hex_plain(hex_of(keccak256(value))) != hex_plain(new_hash)
        give nothing
    give hex_of(value)

-- PcrZeroUpdate(bytes indexed oldPcr0, bytes indexed newPcr0): the topics are keccak256 of the
-- values, so the values come from the calldata of the transaction that emitted each one.
task pcr0_history(c, tee_auth)
    let out be []
    each entry in contract_logs(c, tee_auth, [SIG_PCR0_UPDATE])
        let tx be transaction(c, entry["transactionHash"])
        set out to append(out, {"block": quantity_of(entry["blockNumber"]), "tx": entry["transactionHash"], "old_hash": entry["topics"][1], "new_hash": entry["topics"][2], "new": pcr0_of_calldata(hex_bytes(tx["input"]), entry["topics"][2])})
    give out

task tee_updates(c, tee_auth)
    let out be []
    each entry in contract_logs(c, tee_auth, [SIG_TEE_UPDATE])
        -- TeeUpdate has no indexed parameter: all four are in `data`
        let fields be abi_decode("(address,address,bytes,bytes)", hex_bytes(entry["data"]))
        set out to append(out, {"block": quantity_of(entry["blockNumber"]), "tx": entry["transactionHash"], "old_signer": fields[0], "new_signer": fields[1]})
    give out

-- Pure: AddedAuthority / RemovedAuthority logs replayed in chain order → the addresses allowed now
task allowlist_replay(added, removed)
    let events be []
    each e in added
        set events to append(events, {"order": log_order(e), "address": address_of_topic(e["topics"][2]), "allowed": true})
    each e in removed
        set events to append(events, {"order": log_order(e), "address": address_of_topic(e["topics"][2]), "allowed": false})
    let state be {}
    each e in sort_by(events, (x) => x["order"])
        set state[e["address"]] to e["allowed"]
    give where(keys(state), (k) => state[k])

-- The allowlist of `authority_contract` for `app_id`: the events say whom to ask, the contract's
-- checkAuthorityIsAllowed says whether they are allowed right now.
task allowlist_of(c, authority_contract, app_id)
    let topic_app be "0x" + decode(int_to_bytes(app_id, 32), "hex")
    let added be contract_logs(c, authority_contract, [SIG_ADDED_AUTHORITY, topic_app])
    let removed be contract_logs(c, authority_contract, [SIG_REMOVED_AUTHORITY, topic_app])
    let out be []
    each addr in allowlist_replay(added, removed)
        set out to append(out, {"authority": addr, "allowed": call_typed(c, authority_contract, "bool", "checkAuthorityIsAllowed(uint256,address)", [app_id, addr])})
    give out

-- Everything `governance` prints, as one map (the `--json` output).
task governance(c)
    let processor be need(c, "processor", "VELA_PROCESSOR")
    let tee_auth be need(c, "tee_auth", "VELA_TEE_AUTHENTICATOR")
    let app_id be when c["app_id"] == "" then nothing otherwise int_of(c["app_id"])
    let p be {"address": processor}
    set p["tee_authenticator"] to call_optional(c, processor, "address", "teeAuthenticator()", [])
    set p["authority_registry"] to call_optional(c, processor, "address", "authorityRegistry()", [])
    set p["token_allowlist"] to call_optional(c, processor, "address", "tokenAllowlist()", [])
    set p["fee_collector"] to call_optional(c, processor, "address", "feeCollector()", [])
    set p["min_fee_per_request"] to call_optional(c, processor, "uint256", "minFeePerRequest()", [])
    set p["max_num_of_applications"] to call_optional(c, processor, "uint256", "maxNumOfApplications()", [])
    set p["max_queue_size"] to call_optional(c, processor, "uint256", "maxQueueSize()", [])
    -- Vela dev (v0.3.0): the round-robin grace and the extension the endpoint delegates to; n/a on v0.2.0
    set p["selection_grace"] to call_optional(c, processor, "uint256", "selectionGrace()", [])
    set p["extension"] to call_optional(c, processor, "address", "extension()", [])
    let t be {"address": tee_auth}
    set t["owner"] to call_optional(c, tee_auth, "address", "owner()", [])
    let pcr0 be call_optional(c, tee_auth, "bytes", "pcr0()", [])
    set t["pcr0"] to when pcr0 == nothing then nothing otherwise hex_of(pcr0)
    set t["attested"] to pcr0 != nothing
    set t["tee_signer"] to call_optional(c, tee_auth, "address", "getTeeSigner()", [])
    let pub be call_optional(c, tee_auth, "bytes", "getPubSecp521r1()", [])
    set t["pub_secp521r1"] to when pub == nothing then nothing otherwise hex_of(pub)
    set t["nitro_prover"] to call_optional(c, tee_auth, "address", "nitroProver()", [])
    set t["max_verification_age"] to call_optional(c, tee_auth, "uint256", "maxVerificationAge()", [])
    set t["pcr0_history"] to pcr0_history(c, tee_auth)
    set t["tee_updates"] to tee_updates(c, tee_auth)
    let registry be p["authority_registry"]
    when registry == nothing
        set registry to env("VELA_AUTHORITY_REGISTRY", "")
        when registry == ""
            set registry to nothing
    let r be {"address": registry}
    let a be {"app_id": app_id}
    when registry != nothing
        set r["owner"] to call_optional(c, registry, "address", "owner()", [])
        set r["default_authority"] to call_optional(c, registry, "address", "defaultAuthorityContract()", [])
        when app_id != nothing
            let custom be call_optional(c, registry, "address", "appAuthorityContracts(uint256)", [app_id])
            set r["app_authority"] to when custom == nothing or hex_plain(custom) == hex_plain(ETH) then nothing otherwise custom
            set a["contract"] to when r["app_authority"] == nothing then r["default_authority"] otherwise r["app_authority"]
            when a["contract"] != nothing
                set a["owner"] to call_optional(c, a["contract"], "address", "owner()", [])
                set a["allowlist"] to allowlist_of(c, a["contract"], app_id)
    give {"processor": p, "tee_authenticator": t, "authority_registry": r, "authority": a, "from_block": from_block(c)}

-- Pure: the report as [label, value] rows (a label alone is a heading)
task governance_rows(g)
    let p be g["processor"]
    let t be g["tee_authenticator"]
    let r be g["authority_registry"]
    let a be g["authority"]
    let rows be [["ProcessorEndpoint " + p["address"]]]
    set rows to rows + [["  feeCollector", p["fee_collector"]], ["  minFeePerRequest", p["min_fee_per_request"]], ["  maxNumOfApplications", p["max_num_of_applications"]], ["  maxQueueSize", p["max_queue_size"]], ["  selectionGrace (dev)", p["selection_grace"]], ["  extension (dev)", p["extension"]], ["  teeAuthenticator", p["tee_authenticator"]], ["  authorityRegistry", p["authority_registry"]], ["  tokenAllowlist", p["token_allowlist"]]]
    set rows to rows + [["TeeAuthenticator " + t["address"]], ["  owner", t["owner"]], ["  attestation", when t["attested"] then "Nitro, PCR0 pinned" otherwise "NONE: the key is the owner's word (NoAttestationTeeAuthenticator)"], ["  pcr0", t["pcr0"]], ["  nitroProver", t["nitro_prover"]], ["  maxVerificationAge", t["max_verification_age"]], ["  teeSigner", t["tee_signer"]], ["  pubSecp521r1", t["pub_secp521r1"]]]
    set rows to rows + [["  PcrZeroUpdate history", when length(t["pcr0_history"]) == 0 then "none since block " + g["from_block"] + " (the initial pcr0 is set by the constructor, without an event)" otherwise text(length(t["pcr0_history"])) + " update(s)"]]
    each h in t["pcr0_history"]
        set rows to rows + [["    block " + text(h["block"]), (when h["new"] == nothing then "keccak(new) " + h["new_hash"] + " (value not in this tx's calldata)" otherwise h["new"]) + "  tx " + h["tx"]]]
    set rows to rows + [["  TeeUpdate history", when length(t["tee_updates"]) == 0 then "none since block " + g["from_block"] otherwise text(length(t["tee_updates"])) + " update(s)"]]
    each u in t["tee_updates"]
        set rows to rows + [["    block " + text(u["block"]), u["old_signer"] + " → " + u["new_signer"] + "  tx " + u["tx"]]]
    set rows to rows + [["AuthorityRegistry " + shown(r["address"])], ["  owner", field(r, "owner")], ["  defaultAuthorityContract", field(r, "default_authority")]]
    when a["app_id"] == nothing
        set rows to rows + [["  app authority", "set VELA_APP_ID to see the authority of your app"]]
    otherwise
        let custom be field(r, "app_authority")
        set rows to rows + [["  appAuthorityContracts(" + text(a["app_id"]) + ")", when custom == nothing then "none: the default applies" otherwise custom]]
        set rows to rows + [["Authority for app " + text(a["app_id"]) + " " + shown(field(a, "contract"))], ["  owner", field(a, "owner")]]
        let allowlist be field(a, "allowlist")
        when allowlist == nothing or length(allowlist) == 0
            set rows to rows + [["  allowlist", "empty: nobody can deanonymize this app's data (no AddedAuthority since block " + g["from_block"] + ")"]]
            set allowlist to []
        each entry in allowlist
            set rows to rows + [["  allowed", entry["authority"] + (when entry["allowed"] then "" otherwise "  (event replay says allowed, the contract says NO — check VELA_FROM_BLOCK)")]]
    give rows

task shown(v)
    when v == nothing
        give "n/a"
    give text(v)

task pad(s, n)
    let out be s
    while length(out) < n
        set out to out + " "
    give out

-- pure: rows → aligned text
task table(rows)
    let width be 0
    each r in rows
        when length(r) > 1 and length(r[0]) > width
            set width to length(r[0])
    let lines be []
    each r in rows
        set lines to append(lines, when length(r) == 1 then r[0] otherwise pad(r[0], width) + "  " + shown(r[1]))
    give join(lines, "\n")

-- ---- CLI ----

task usage()
    print("usage: synsema run vela_client.syn -- devnet [host] | allow-token <address> | allow-authority <appId> <address> | keys | address | tee [--verify [--pcr0 <hex>]] | governance [--json] | deploy <wasm> [params-json|-] [trigger] | register | deposit <amount> [token] | send '<json>' [wei] | report '<json>' | report-download <reportId> | events [n] | app-events [n] | status <requestId> | user | register-for | send-for '<json>' [amount token] | events-for [n]   (--verified: `tee --verify` before encrypting anything)")

task arg_or(a, i, default)
    give when length(a) > i then a[i] otherwise default

-- The value after `--name`, or nothing when the flag is absent
task flag_value(a, name)
    let i be index_of(a, name)
    when i == nothing
        give nothing
    when length(a) <= i + 1
        raise(name + " needs a value")
    give a[i + 1]

task run_cli(a, verified)
    when length(a) == 0
        usage()
        give nothing
    let c be cfg()
    match a[0]
        is "keys"
            let kp be ecdh_keypair("P-521")
            print("VELA_P521_KEY=" + decode(reveal(kp["private"]), "hex"))
            print("VELA_P521_PUB=" + decode(kp["public"], "hex"))
        is "address"
            print(me())
        is "tee"
            when contains(a, "--verify")
                print_verified(verify_tee(c, flag_value(a, "--pcr0")))
            otherwise
                print(hex_of(tee_public_key(c)))
        is "governance"
            let g be governance(c)
            when contains(a, "--json")
                print(json_encode(g))
            otherwise
                print(table(governance_rows(g)))
        is "deploy"
            let params be when length(a) > 2 and a[2] != "-" then json_decode(a[2]) otherwise nothing
            let trigger be arg_or(a, 3, nothing)
            let ids be deploy(c, a[1], params, trigger)
            print("deploy submitted: app " + text(ids["app_id"]) + ", request " + ids["request_id"])
            let row be wait_completed(c, ids["request_id"], true)
            print("deploy completed at block " + text(row["blockNumber"]) + " — put VELA_APP_ID=" + text(ids["app_id"]) + " in .env")
        is "register"
            let id be submit(c, ASSOCIATE_KEY, register_payload(c, verified), ETH, 0)
            print("register submitted: " + id)
            wait_completed(c, id, false)
            print("registered " + me() + " with a privacy seed (50 subtypes)")
        is "deposit"
            let token be lower(arg_or(a, 2, ETH))
            let amount be int_of(a[1])
            when token != ETH
                -- An ERC-20 deposit: the endpoint pulls the tokens (transferFrom), so approve it first.
                approve(c, token, amount)
            let id be submit(c, PROCESS, bytes(""), token, amount)
            print("deposit submitted: " + id)
            wait_completed(c, id, false)
            print("deposit completed" + (when token == ETH then "" otherwise " (" + token + ")"))
        is "send"
            let plain be json_encode(json_decode(a[1]))
            let wei be when length(a) > 2 then int_of(a[2]) otherwise 0
            let payload be seal_for_executor(c, bytes(plain), verified)
            let id be submit(c, PROCESS, payload, ETH, wei)
            print("request submitted: " + id)
            let row be wait_completed(c, id, false)
            print("completed at block " + text(row["blockNumber"]) + ", fees " + text(row["applicationFees"]) + " wei")
        is "report"
            let plain be json_encode(json_decode(arg_or(a, 1, "{}")))
            let payload be seal_for_executor(c, bytes(plain), verified)
            let id be submit(c, DEANONYMIZATION, payload, ETH, 0)
            print("report request submitted: " + id)
            wait_completed(c, id, false)
            print("report generated: " + need(c, "app_id", "VELA_APP_ID") + "_" + slice(id, 2, length(id)))
            print(json_encode(download_report(c, id)))
        is "report-download"
            print(json_encode(download_report(c, a[1])))
        is "user"
            print(user_address())
        is "register-for"
            let id be submit_for(c, ASSOCIATE_KEY, register_payload_for(c, verified), ETH, 0)
            print("register submitted by the facilitator: " + id)
            wait_completed(c, id, false)
            print("registered " + user_address() + " (the user paid nothing)")
        is "send-for"
            let plain be json_encode(json_decode(a[1]))
            let amount be when length(a) > 2 then int_of(a[2]) otherwise 0
            let token be lower(arg_or(a, 3, ETH))
            let payload be seal_for_executor(c, bytes(plain), verified)
            let id be submit_for(c, PROCESS, payload, token, amount)
            print("request submitted by the facilitator for " + user_address() + ": " + id)
            let row be wait_completed(c, id, false)
            print("completed at block " + text(row["blockNumber"]) + ", fees " + text(row["applicationFees"]) + " wei (paid by the facilitator)")
        is "events-for"
            each item in events_for(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        is "events"
            each item in my_events(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        is "app-events"
            each item in app_events(c, floor(number(arg_or(a, 1, "10"))))
                print(json_encode(item))
        is "status"
            let row be completion(c, lower(a[1]), false)
            when row == nothing
                set row to completion(c, lower(a[1]), true)
            print(when row == nothing then "pending (not completed yet)" otherwise json_encode(row))
        is "devnet"
            let host be arg_or(a, 1, "devnet.synsema.app")
            let values be devnet_env(host)
            env_write(".env", values)
            each k in keys(values)
                print(k + "=" + text(values[k]))
            print("written to .env: a token of your own on " + host + " (the admin key there is Anvil #0; allow-token / allow-authority are yours to run)")
        is "allow-token"
            let receipt be allow_token(c, lower(a[1]))
            print("token " + lower(a[1]) + " allowlisted (tx " + text(receipt["transactionHash"]) + ")")
        is "allow-authority"
            let receipt be allow_authority(c, int_of(a[1]), lower(a[2]))
            print("authority " + lower(a[2]) + " allowed for app " + a[1] + " (tx " + text(receipt["transactionHash"]) + ")")
        otherwise
            usage()

-- `--verified` may sit anywhere in the command line; it is a mode, not a positional argument.
let argv be args()
run_cli(where(argv, (x) => x != "--verified"), contains(argv, "--verified"))

-- ---------------------------------------------------------------------------------------
-- tests (pure: no chain, no network): `synsema test vela_client.syn`
-- ---------------------------------------------------------------------------------------

test "decimal text becomes an exact integer beyond 2^53"
    assert_eq(text(int_of("9105241052143571847")), "9105241052143571847")
    assert_eq(int_of("100"), 100)
    assert_eq(int_of("0"), 0)

test "a payload round-trips through the Executor's cipher (P-521 ECDH → HKDF → AES-256-GCM)"
    let user be ecdh_keypair("P-521")
    let tee be ecdh_keypair("P-521")
    let k_user be derive_key(user["private"], tee["public"])
    let k_tee be derive_key(tee["private"], user["public"])
    let blob be seal(k_user, bytes("{\"type\":\"transfer\"}"))
    assert_eq(length(blob), 12 + 19 + 16)
    assert_eq(decode(open(k_tee, blob)), "{\"type\":\"transfer\"}")
    assert_error(() => open(k_tee, slice(blob, 0, 27)))

test "the seed is a 65-byte signature and yields 50 distinct 32-byte subtypes"
    let k be as_secret("ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80", "VELA_SECP_KEY")
    let s be seed_of(k)
    assert_eq(length(s), 65)
    assert_eq(s, seed_of(k))
    let subs be subtypes(s)
    assert_eq(length(subs), 50)
    assert_eq(length(subs[0]), 66)
    assert_eq(length(unique(subs)), 50)

test "request and deploy ids come out of the receipt logs"
    let req be "0x" + decode(bytes([171]) + int_to_bytes(0, 31), "hex")
    let receipt be {"logs": [{"topics": ["0xdead"], "data": bytes([])}, {"topics": [SIG_REQUEST_SUBMITTED, "0x" + decode(int_to_bytes(7, 32), "hex"), req, "0x" + decode(int_to_bytes(0, 32), "hex")], "data": bytes([])}]}
    assert_eq(request_id_of(receipt), req)
    let dep be {"logs": [{"topics": [SIG_DEPLOY_SUBMITTED, "0x" + decode(int_to_bytes(9105241052143571847, 32), "hex"), "0x" + decode(int_to_bytes(0, 32), "hex")], "data": bytes([205]) + int_to_bytes(0, 31)}]}
    let ids be deploy_ids_of(dep)
    assert_eq(text(ids["app_id"]), "9105241052143571847")
    assert_eq(slice(ids["request_id"], 0, 4), "0xcd")
    assert_error(() => request_id_of({"logs": []}))

test "a subtype reads back as its label when it is one, and as nothing when it is a hash"
    let label be "execute_requested"
    let padded be bytes(label) + int_to_bytes(0, 32 - length(bytes(label)))
    assert_eq(subtype_label(hex_of(padded)), label)
    assert_eq(subtype_label(hex_of(keccak256("INV-1"))), nothing)
    assert_eq(subtype_label(hex_of(int_to_bytes(0, 32))), nothing)

test "the facilitator's typed data digests are 32 bytes and change with every field that matters"
    let processor be "0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"
    let user be "0x1111111111111111111111111111111111111111"
    let d1 be authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000)
    let d2 be authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 1, 1800000000)
    let d3 be authorization_digest(1, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000)
    assert_eq(length(d1), 32)
    assert(d1 != d2)
    assert(d1 != d3)
    assert_eq(d1, authorization_digest(31337, processor, user, 7, PROCESS, bytes("payload"), ETH, 0, 0, 1800000000))
    let p1 be permit_digest(31337, processor, "Test Token", user, processor, 1000000, 0, 1800000000)
    assert_eq(length(p1), 32)
    assert(p1 != permit_digest(31337, processor, "Test Token", user, processor, 1000000, 1, 1800000000))
    let k be as_secret("ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80", "VELA_USER_KEY")
    let sig be sign_eth(d1, k)
    assert_eq(length(sig), 65)
    assert(sig[64] == 27 or sig[64] == 28)
    assert_eq(length(permit_bytes(sig)), 96)
    assert_eq(permit_bytes(sig)[31], sig[64])

test "submitRequest calldata carries the selector and the ETH value rule is asset + fee"
    let data be abi_encode("submitRequest(uint8,uint64,uint8,bytes,address,uint256,uint256)", [0, 1, PROCESS, bytes("x"), ETH, 5, 100])
    assert_eq(slice(data, 0, 4), abi_selector("submitRequest(uint8,uint64,uint8,bytes,address,uint256,uint256)"))
    assert_eq(length(SIG_REQUEST_SUBMITTED), 66)
    assert_eq(length(SIG_DEPLOY_SUBMITTED), 66)

test "a failed request is reported by its message first; the code is a datum, never interpreted"
    let m be failure_message("0xab", {"status": 1, "errorCode": 12, "errorMessage": "insufficient fuel"})
    assert(starts_with(m, "request 0xab failed: insufficient fuel"))
    assert(contains(m, "errorCode 12"))
    assert(contains(failure_message("0xab", {"status": 1, "errorCode": 2, "errorMessage": nothing}), "(no message)"))

test "updateTee / updateTeeStep1 calldata gives back the attestation document; anything else is refused"
    let doc be bytes("a COSE_Sign1 document, in real life")
    let whole be attestation_of_calldata(abi_encode("updateTee(bytes)", [doc]))
    assert_eq(whole["document"], doc)
    assert_eq(whole["via"], "updateTee")
    let step be attestation_of_calldata(abi_encode("updateTeeStep1(bytes)", [doc]))
    assert_eq(step["document"], doc)
    assert_eq(step["via"], "updateTeeStep1")
    -- The NoAttestationTeeAuthenticator's updateTee(address,bytes) is not an attestation
    assert_error(() => attestation_of_calldata(abi_encode("updateTee(address,bytes)", ["0x1111111111111111111111111111111111111111", doc])))
    assert_error(() => attestation_of_calldata(abi_encode("updateTeeStep4()", [])))
    assert_error(() => attestation_of_calldata(bytes([1, 2])))

test "the attested key matches getPubSecp521r1() raw or as DER, and nothing else"
    let point be bytes([4]) + random_bytes(132)
    let der be bytes("30819b301006072a8648ce3d020106052b81040023038186", "hex") + bytes([0]) + point
    assert_eq(key_matches(point, point), "raw (0x04 ‖ X ‖ Y)")
    assert_eq(key_matches(der, point), "DER SubjectPublicKeyInfo")
    assert_eq(key_matches(bytes([4]) + random_bytes(132), point), nothing)
    assert_eq(key_matches(nothing, point), nothing)

test "binding the document to the chain fails on the key, the signer, the PCR0 or --pcr0, each on its own"
    let key be bytes([4]) + random_bytes(132)
    let signer be "0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9"
    let pcr0 be "0x" + decode(random_bytes(48), "hex")
    let att be {"public_key": key, "user_data": hex_bytes(signer), "measurements": {"pcr0": slice(pcr0, 2, length(pcr0))}}
    assert_eq(bind_attestation(att, key, signer, pcr0, nothing), "raw (0x04 ‖ X ‖ Y)")
    assert_eq(bind_attestation(att, key, lower(signer), upper(pcr0), pcr0), "raw (0x04 ‖ X ‖ Y)")
    assert_error(() => bind_attestation(att, bytes([4]) + random_bytes(132), signer, pcr0, nothing))
    assert_error(() => bind_attestation(att, key, "0x1111111111111111111111111111111111111111", pcr0, nothing))
    assert_error(() => bind_attestation(att, key, signer, "0x" + decode(random_bytes(48), "hex"), nothing))
    assert_error(() => bind_attestation(att, key, signer, pcr0, "0x" + decode(random_bytes(48), "hex")))
    assert_error(() => bind_attestation({"public_key": key, "user_data": bytes([1, 2, 3]), "measurements": {"pcr0": pcr0}}, key, signer, pcr0, nothing))

test "hex quantities round-trip the JSON-RPC way (no leading zeros, 0x0 for zero)"
    assert_eq(hex_quantity(0), "0x0")
    assert_eq(hex_quantity(5), "0x5")
    assert_eq(hex_quantity(26), "0x1a")
    assert_eq(hex_quantity(65536), "0x10000")
    assert_eq(quantity_of("0x1a"), 26)
    assert_eq(quantity_of("0x0"), 0)
    assert_eq(quantity_of("0x10000"), 65536)
    assert_eq(log_order({"blockNumber": "0x2", "logIndex": "0x3"}), 200003)
    assert_eq(address_of_topic("0x000000000000000000000000dc64a140aa3e981100a9beca4e685f962f0cf6c9"), "0xdc64a140aa3e981100a9beca4e685f962f0cf6c9")

test "updatePcr0 calldata yields the new PCR0 only when it hashes to the event's indexed topic"
    let value be random_bytes(48)
    let topic be hex_of(keccak256(value))
    assert_eq(pcr0_of_calldata(abi_encode("updatePcr0(bytes)", [value]), topic), hex_of(value))
    assert_eq(pcr0_of_calldata(abi_encode("updatePcr0(bytes)", [random_bytes(48)]), topic), nothing)
    assert_eq(pcr0_of_calldata(abi_encode("updateTee(bytes)", [value]), topic), nothing)
    assert_eq(pcr0_of_calldata(bytes([]), topic), nothing)

test "the allowlist is the replay of AddedAuthority / RemovedAuthority in chain order"
    task topic_of(addr)
        give "0x" + decode(int_to_bytes(0, 12), "hex") + slice(addr, 2, length(addr))
    let alice be "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let bob be "0xbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    let added be [{"blockNumber": "0x5", "logIndex": "0x0", "topics": [SIG_ADDED_AUTHORITY, "0x7", topic_of(alice)]}, {"blockNumber": "0x6", "logIndex": "0x1", "topics": [SIG_ADDED_AUTHORITY, "0x7", topic_of(bob)]}, {"blockNumber": "0x9", "logIndex": "0x0", "topics": [SIG_ADDED_AUTHORITY, "0x7", topic_of(alice)]}]
    let removed be [{"blockNumber": "0x8", "logIndex": "0x0", "topics": [SIG_REMOVED_AUTHORITY, "0x7", topic_of(alice)]}]
    assert_eq(allowlist_replay(added, removed), [alice, bob])
    -- Removed after the last add: gone
    let removed_late be removed + [{"blockNumber": "0x9", "logIndex": "0x1", "topics": [SIG_REMOVED_AUTHORITY, "0x7", topic_of(alice)]}]
    assert_eq(allowlist_replay(added, removed_late), [bob])
    assert_eq(allowlist_replay([], []), [])

test "the governance report renders every section from a fixed map, as text and as JSON"
    let g be {
        "from_block": "0x0",
        "processor": {"address": "0xP", "fee_collector": "0xF", "min_fee_per_request": 100, "max_num_of_applications": 10, "max_queue_size": 10, "selection_grace": nothing, "extension": nothing, "tee_authenticator": "0xT", "authority_registry": "0xR", "token_allowlist": "0xL"},
        "tee_authenticator": {"address": "0xT", "owner": "0xO", "attested": true, "pcr0": "0xabc", "nitro_prover": "0xN", "max_verification_age": 3600, "tee_signer": "0xS", "pub_secp521r1": "0x04ff", "pcr0_history": [{"block": 12, "tx": "0xt1", "old_hash": "0xh0", "new_hash": "0xh1", "new": "0xabc"}, {"block": 15, "tx": "0xt2", "old_hash": "0xh1", "new_hash": "0xh2", "new": nothing}], "tee_updates": [{"block": 13, "tx": "0xt3", "old_signer": "0x0", "new_signer": "0xS"}]},
        "authority_registry": {"address": "0xR", "owner": "0xO", "default_authority": "0xD", "app_authority": nothing},
        "authority": {"app_id": 7, "contract": "0xD", "owner": "0xO", "allowlist": [{"authority": "0xa1", "allowed": true}, {"authority": "0xa2", "allowed": false}]}
    }
    let out be table(governance_rows(g))
    assert(contains(out, "ProcessorEndpoint 0xP"))
    assert(contains(out, "minFeePerRequest"))
    assert(contains(out, "selectionGrace (dev)") and contains(out, "n/a"))
    assert(contains(out, "Nitro, PCR0 pinned"))
    assert(contains(out, "2 update(s)"))
    assert(contains(out, "block 12") and contains(out, "0xabc  tx 0xt1"))
    assert(contains(out, "value not in this tx's calldata"))
    assert(contains(out, "0x0 → 0xS"))
    assert(contains(out, "none: the default applies"))
    assert(contains(out, "Authority for app 7 0xD"))
    assert(contains(out, "0xa1") and contains(out, "0xa2  (event replay says allowed, the contract says NO"))
    assert(length(json_decode(json_encode(g))["tee_authenticator"]["pcr0_history"]) == 2)
    -- No attestation, no app id, empty history
    let bare be {"from_block": "0x0", "processor": g["processor"], "tee_authenticator": {"address": "0xT", "owner": "0xO", "attested": false, "pcr0": nothing, "nitro_prover": nothing, "max_verification_age": nothing, "tee_signer": "0xS", "pub_secp521r1": "0x04ff", "pcr0_history": [], "tee_updates": []}, "authority_registry": {"address": nothing}, "authority": {"app_id": nothing}}
    let out2 be table(governance_rows(bare))
    assert(contains(out2, "NONE: the key is the owner's word"))
    assert(contains(out2, "set by the constructor"))
    assert(contains(out2, "set VELA_APP_ID"))
