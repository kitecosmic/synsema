# Vela client (vela_client.syn) — copy to .env next to the program.
# Values below are the starter kit's local environment (docker compose in vela-starterkit/dockerfiles).

VELA_RPC_URL=http://localhost:8545
# Written by the deployer container to /deploy-data/deployed_addresses.env
VELA_PROCESSOR=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
VELA_TEE_AUTHENTICATOR=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VELA_AUTHORITY_URL=http://localhost:8081
VELA_SUBGRAPH_URL=http://localhost:8000/subgraphs/name/hcce

# The app you talk to (printed by `deploy`).
VELA_APP_ID=
# Fee reserved per request, in wei (>= MIN_FEE_PER_REQUEST; the unused part is refunded on-chain).
VELA_MAX_FEE=100

# `governance` and `tee --verify` read the contracts' logs (PcrZeroUpdate, TeeUpdate, AddedAuthority)
# from this block on. 0 is fine on a local Anvil; on a public RPC that caps eth_getLogs ranges, set it
# to the block the contracts were deployed at. `tee --verify` walks at most VELA_SCAN_BLOCKS (256)
# blocks back for an updateTeeStep1 when the last update came through the step flow.
VELA_FROM_BLOCK=0

# secp256k1 key that signs the transactions — Anvil account #0 (has DEPLOYER_ROLE and 10 000 ETH).
VELA_SECP_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# P-521 pair for the private channel with the Executor: `synsema run vela_client.syn -- keys`.
VELA_P521_KEY=
VELA_P521_PUB=

# Facilitator commands (register-for / send-for / events-for): the USER's secp256k1 key. The user
# signs typed data only; VELA_SECP_KEY submits and pays. Any key works — it needs no ETH.
VELA_USER_KEY=
