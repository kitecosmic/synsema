-- Gemelo de batch6_conformance.rs (core) (v0.6.68, migas §4): `raise(msg)` y el parseo/ejecución
-- de `signal`/`wait_for` con nombre dinámico (las cláusulas `with`/`as` no se tragan la expresión).
-- La ruta real de spawn-desde-route y los canales por job_id viven en los tests del runtime.
-- OJO: bajo `synsema test` el hook de swarm es REAL — un wait_for sin señal con datos espera el
-- deadline (30 s por defecto); el veredicto es igual al de Rust, sólo cambia el tiempo de pared.
-- Correr con: synsema test tests/batch6_conformance.test.syn

task reraise()
    try
        let x be (1 / 0)
    recover err
        raise(err)

task check(n)
    when n < 0
        raise("negative not allowed")
    give n

task expect_error(f, needle)
    let ok be false
    try
        f()
    recover e
        set ok to true
        assert(contains(e, needle))
    assert(ok)

test "raise_propagates_message"
    expect_error(() => raise("boom"), "boom")
    expect_error(() => raise("custom error " + text(42)), "custom error 42")

test "raise_coerces_to_text"
    expect_error(() => raise(42), "42")

test "raise_without_arg_errors"
    expect_error(() => raise(), "raise")

test "raise_reraises_captured_error"
    -- try/recover SIN raise → el error se traga (el programa sigue).
    let outcome be "not run"
    try
        let x be (1 / 0)
    recover err
        set outcome to "caught"
    assert_eq(outcome, "caught")
    -- try/recover CON raise(err) → el error se re-propaga con el original.
    expect_error(() => reraise(), "Division by zero")

test "raise_inside_task_propagates"
    expect_error(() => check(-1), "negative not allowed")

test "signal_literal_still_parses"
    -- Regresión: literal sigue funcionando (ahora es un TextLiteral evaluado).
    signal "x"
    assert(true)

test "signal_dynamic_name_and_with_clause"
    -- `signal <expr> with <data>` — el `with` NO se traga la expresión del nombre.
    let id be 7
    signal "cancel:" + text(id) with {"reason": "timeout"}
    assert(true)

test "wait_for_literal_and_dynamic_with_as"
    -- literal con `as`: sin señal con datos → nothing. (El `signal "x"` de arriba dejó una
    -- señal pendiente SIN datos: se consume al vuelo y también da nothing.)
    wait_for "x" as r
    assert(r == nothing)
    -- `wait_for <expr> as <var>` — el `as` NO se traga la expresión del nombre.
    let job be 3
    wait_for "done:" + text(job) as result
    assert(result == nothing)
