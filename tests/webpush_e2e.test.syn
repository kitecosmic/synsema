-- Gemelo de webpush_e2e.rs (v0.6.68, migas §4): las PUERTAS de push_send sin red real —
-- el gate `net` del host del endpoint, el rechazo de endpoints http fuera de loopback y
-- la doctrina de la privada VAPID (sólo sellada, jamás texto plano y sin ecoar el valor).
-- Más push_vapid_keys: gate por `random` y la privada que NACE sellada (redactada al
-- imprimirla, 43 chars con reveal). Todos los errores saltan ANTES de abrir socket, así
-- que no hay red. El material de la suscripción (p256dh = punto P-256 en base64url, auth
-- = 16 bytes) sale de push_vapid_keys() y de un literal b64url, como keygen() del host.
-- QUEDAN en Rust: push_send_delivers_an_rfc8291_body_the_browser_can_decrypt y
-- push_send_reports_gone_subscriptions — push service simulado en un socket del host y
-- descifrado RFC 8291 lado navegador desde Rust.
-- ORDEN: push_vapid_keys va PRIMERO — su negación de `random` exige que ningún bloque
-- anterior haya concedido `require random` (los require del archivo valen para TODA la
-- corrida).
-- Correr con: synsema test tests/webpush_e2e.test.syn

test "push_vapid_keys_needs_random_and_seals_the_private_key"
    let denied be false
    try
        let k0 be push_vapid_keys()
    recover e
        set denied to true
        assert(contains(e, "random"))
    assert(denied)
    -- reveal() es ruidoso a propósito: capability por nombre del secret + audit.
    require random
    require reveal("vapid_private")
    let k be push_vapid_keys()
    -- Pública: 65 bytes → 87 chars base64url. Privada: 32 bytes → 43 chars, y al
    -- imprimirla/text() sale redactada (sin "=", nunca el valor).
    assert_eq(length(k["public"]), 87)
    let shown be text(k["private"])
    assert(contains(shown, "secret"))
    assert(not contains(shown, "="))
    assert_eq(length(reveal(k["private"])), 43)

test "push_send_is_gated_by_net_of_the_endpoint_host"
    -- Sin `require net` no se abre ni el socket: la negación nombra la capability y el
    -- host del endpoint.
    require random
    require reveal("vapid_private")
    let k be push_vapid_keys()
    let sub be {"endpoint": "http://127.0.0.1:1/push/v1/abc", "keys": {"p256dh": k["public"], "auth": "AAAAAAAAAAAAAAAAAAAAAA"}}
    let ok be false
    try
        let r be push_send(sub, {"title": "hola"}, {"vapid": {"public": k["public"], "private": as_secret(reveal(k["private"]), "vapid"), "subject": "mailto:ops@example.com"}})
    recover e
        set ok to true
        assert(contains(e, "net"))
        assert(contains(e, "127.0.0.1"))
    assert(ok)

test "push_send_refuses_plaintext_endpoints_off_loopback"
    require random
    require reveal("vapid_private")
    require net("push.example.com")
    let k be push_vapid_keys()
    let sub be {"endpoint": "http://push.example.com/x", "keys": {"p256dh": k["public"], "auth": "AAAAAAAAAAAAAAAAAAAAAA"}}
    let ok be false
    try
        let r be push_send(sub, "x", {"vapid": {"public": k["public"], "private": as_secret(reveal(k["private"]), "vapid"), "subject": "mailto:a@b.c"}})
    recover e
        set ok to true
        assert(contains(e, "must be https://"))
    assert(ok)

test "push_send_refuses_a_plain_text_private_key"
    -- La misma clave, válida, pero como texto plano: error de doctrina, sin filtrar el valor.
    require random
    require reveal("vapid_private")
    require net("127.0.0.1")
    let k be push_vapid_keys()
    let plain be reveal(k["private"])
    let sub be {"endpoint": "http://127.0.0.1:1/x", "keys": {"p256dh": k["public"], "auth": "AAAAAAAAAAAAAAAAAAAAAA"}}
    let ok be false
    try
        let r be push_send(sub, "x", {"vapid": {"public": k["public"], "private": plain, "subject": "mailto:a@b.c"}})
    recover e
        set ok to true
        assert(contains(e, "must be a secret"))
        assert(not contains(e, plain))
    assert(ok)
