-- Sonda del perfil wasm, parte 4: la semántica de `sandbox` no se malinterpreta —
-- adentro TODO está denegado (random/secret/time), `require` adentro no re-concede,
-- una task llamada desde adentro tampoco escapa, el estado se RESTAURA al salir
-- (también tras un raise), anidado y como expresión. Misma salida nativo/wasm.
-- Desde v0.6.51 un `sandbox` pelado también niega stdout: lo de adentro se guarda en variables
-- y se imprime al salir.
-- Con `--sandbox` (techo del host) la primera línea ya debe fallar: `require random`
-- está por encima del techo [stdout, time].

require random
require secret("ETH_KEY")

print(`outside_random={type_of(random())}`)
print(`outside_secret={type_of(secret("ETH_KEY"))}`)

let s_random be ""
let s_secret be ""
let s_time be ""
let s_require be ""
let s_pure be ""
sandbox
    try
        random()
        set s_random to "PERMITIDO"
    recover e
        set s_random to `{e}`
    try
        secret("ETH_KEY")
        set s_secret to "PERMITIDO"
    recover e
        set s_secret to `{e}`
    try
        now()
        set s_time to "PERMITIDO"
    recover e
        set s_time to `{e}`
    require random
    try
        random()
        set s_require to "ESCAPO"
    recover e
        set s_require to `{e}`
    set s_pure to `{sum([1, 2, 3])}`
print(`sandbox_random={s_random}`)
print(`sandbox_secret={s_secret}`)
print(`sandbox_time={s_time}`)
print(`sandbox_require={s_require}`)
print(`sandbox_pure={s_pure}`)

print(`after_random={type_of(random())}`)
print(`after_secret={type_of(secret("ETH_KEY"))}`)

let v be sandbox 2 + 3
print(`sandbox_expr={v}`)

let n_inner be ""
let n_outer be ""
sandbox
    sandbox
        try
            random()
            set n_inner to "PERMITIDO"
        recover e
            set n_inner to `{e}`
    try
        random()
        set n_outer to "PERMITIDO"
    recover e
        set n_outer to `{e}`
print(`nested_inner={n_inner}`)
print(`nested_outer={n_outer}`)
print(`after_nested={type_of(random())}`)

try
    sandbox
        raise("boom")
recover e
    print(`sandbox_raise={e}`)
print(`after_raise={type_of(random())}`)

task lee_secreto()
    give secret("ETH_KEY")
let t_sandbox be ""
sandbox
    try
        lee_secreto()
        set t_sandbox to "PERMITIDO"
    recover e
        set t_sandbox to `{e}`
print(`task_in_sandbox={t_sandbox}`)
print(`after_task={type_of(lee_secreto())}`)
