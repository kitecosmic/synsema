-- Gemelo de stats_conformance.rs (v0.6.68, migas §4): las mismas aserciones, sobre valores.
-- Los tests de Rust que afirman texto decorado del host no están acá (migas §1).
-- Correr con: synsema test tests/stats_conformance.test.syn

task expect_error(f, needle)
    let ok be false
    try
        f()
    recover e
        set ok to true
        assert(contains(e, needle))
    assert(ok)

test "median_even_and_odd"
    assert_eq(text(median([1, 2, 3, 4])), "2.5")
    assert_eq(text(median([1, 2, 3])), "2.0")
    assert_eq(text(median([5])), "5.0")
    assert_eq(text(median([3, 1, 4, 1, 5])), "3.0")

test "percentile_extremes_and_median"
    assert_eq(text(percentile([1, 5, 9], 0)), "1.0")
    assert_eq(text(percentile([1, 5, 9], 100)), "9.0")
    assert(percentile([3, 1, 4, 1, 5], 50) == median([3, 1, 4, 1, 5]))

test "percentile_numpy_vectors"
    assert_eq(text(percentile([1, 2, 3, 4], 25)), "1.75")
    assert_eq(text(percentile([15, 20, 35, 40, 50], 40)), "29.0")
    assert(abs(percentile([1, 2, 3, 4, 5], 95) - 4.8) < 0.000000001)

test "histogram_uniform_bins"
    let h be histogram(range(10), 5)
    assert_eq(h["counts"], [2, 2, 2, 2, 2])
    assert_eq(length(h["edges"]), 6)
    assert_eq(text(h["edges"][0]), "0.0")
    assert_eq(text(h["edges"][5]), "9.0")

test "histogram_explicit_edges_last_bin_closed"
    assert_eq(histogram([1, 2, 3, 4], [0, 2, 4])["counts"], [1, 3])
    assert_eq(histogram([-5, 1, 99], [0, 2])["counts"], [1])

test "histogram_all_equal_expands_range"
    assert_eq(histogram([7, 7, 7], 2)["counts"], [0, 3])

test "histogram_default_ten_bins"
    assert(length(histogram(range(100))["counts"]) == 10)

test "arrays_and_lists_agree"
    assert(median(array([1, 2, 3, 4])) == median([1, 2, 3, 4]))
    assert(percentile(array([15, 20, 35, 40, 50]), 40) == percentile([15, 20, 35, 40, 50], 40))
    assert(histogram(array([1, 2, 3]), 2) == histogram([1, 2, 3], 2))

test "errors_empty_nan_and_bad_p"
    expect_error(() => median([]), "empty")
    assert(is_nan(median([1, nan, 3])))
    expect_error(() => percentile([1, 2], 101), "between 0 and 100")
    expect_error(() => percentile([1, 2], -1), "between 0 and 100")
    expect_error(() => histogram([1, 2], [3, 2]), "strictly increasing")
    expect_error(() => histogram([1, 2], 0), "at least 1")
    expect_error(() => median([1, "x"]), "expects numbers")
    expect_error(() => median("nope"), "list of numbers or an array")

test "existing_aggregates_untouched_g1"
    assert_eq(text(mean([1, 2, 3, 4])), "2.5")
    assert(mean([1, 2, 3, 4]) == percentile([1, 2, 3, 4], 50))
    assert_eq(text(sum([1, 2, 3])), "6")
