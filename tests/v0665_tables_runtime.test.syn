-- Runtime table, hash and Parquet integration.

test "hash_of_a_table_is_stable"
    let rows be [{"k": 1, "v": 1.5}, {"k": 2, "v": 2.5}, {"k": 3, "v": 3.5}]
    assert(hash(table(rows)) == hash(table(rows)))
    assert(hash(table(rows)) != hash(table([{"k": 1, "v": 1.5}, {"k": 2, "v": 2.5}, {"k": 3, "v": 3.5001}])))
    assert(hash(slice(table(rows), 0, 3)) == hash(table(rows)))
    assert(hash(table(to_rows(table(rows)))) == hash(table(rows)))
    let nulls be table([{"k": 1, "v": nothing}])
    assert(hash(nulls) == hash(table(to_rows(nulls))))

test "json_encode_of_a_table_is_the_rows_one"
    let rows be [{"k": 1, "v": 1.5}, {"k": 2, "v": 2.5}, {"k": 3, "v": 3.5}]
    assert(json_encode(table(rows)) == json_encode(to_rows(table(rows))))
    assert_eq(json_encode(table([{"k": 1, "v": 1.5}, {"k": 2, "v": 2.5}])), "[{\"k\": 1, \"v\": 1.5}, {\"k\": 2, \"v\": 2.5}]")

test "table_v1_hash_is_sensitive_to_nulls_and_windows"
    assert(hash(table([{"k": 1, "v": nothing}])) != hash(table([{"k": 1, "v": 0.0}])))
    let rows be [{"k": 1, "v": 1.5}, {"k": 2, "v": 2.5}, {"k": 3, "v": 3.5}]
    assert(hash(slice(table(rows), 1, 3)) == hash(table([{"k": 2, "v": 2.5}, {"k": 3, "v": 3.5}])))
    assert(hash(slice(table(rows), 1, 3)) != hash(table(rows)))

test "parquet_nested_columns_fall_back_to_rows_as_a_table"
    require file.read("engine/crates/synsema-runtime/tests/fixtures/parquet_nested_list.parquet")
    let t be parquet_read(read_file_bytes("engine/crates/synsema-runtime/tests/fixtures/parquet_nested_list.parquet"))
    assert_eq(type_of(t), "table")
    assert_eq(text(t[0].tags), "[\"a\", \"b\"]")
    assert_eq(text(t[1].tags), "[]")
    assert_eq(text(t[2].tags), "[\"c\"]")
    assert_eq(t[0].id, 1)
    assert_eq(t[2].id, 3)

test "parquet_read_gives_a_table_with_the_same_types"
    require file.read("engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet")
    let t be parquet_read(read_file_bytes("engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet"))
    assert_eq(type_of(t), "table")
    assert_eq(length(columns(t)), 7)
    assert_eq(columns(t)[0], "id")
    assert_eq(t[2].id, nothing)
    assert_eq(t[1].name, nothing)
    assert_eq(type_of(t[0].d), "date")
    assert_eq(type_of(t[0].amt), "decimal")
    assert_eq(t[0].id, 1)
    assert_eq(t[0].x, 1.5)
    assert(summarize(t, "ok", {"n": count(), "s": sum_of("x")}) == summarize(to_rows(t), "ok", {"n": count(), "s": sum_of("x")}))
    assert(parquet_read(parquet_write(t)) == t)
    assert(parquet_read(parquet_write(t, {"compression": "zstd"})) == t)

test "parquet_options_on_the_columnar_path"
    require file.read("engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet")
    let p be "engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet"
    assert_eq(type_of(parquet_scan(p)), "table")
    assert_eq(text(columns(parquet_scan(p, {"columns": ["id", "x"]}))), "[\"id\", \"x\"]")
    let subset be parquet_scan(p, {"columns": ["id", "x"]})
    assert_eq(subset[0].id, 1)
    assert_eq(subset[0].x, 1.5)
    assert_eq(length(parquet_scan(p, {"limit": 2})), 2)

test "table_views_cross_parallel_map_and_summarize_the_same"
    let t be table([{"k": 1, "v": 1.5}, {"k": 1, "v": 2.5}, {"k": 2, "v": 3.5}, {"k": 2, "v": 4.5}])
    let parts be [slice(t, 0, 2), slice(t, 2, 4)]
    let many be parallel_map((p) => summarize(p, "k", {"n": count(), "s": sum_of("v")}), parts, 2)
    assert(many[0] == summarize(slice(t, 0, 2), "k", {"n": count(), "s": sum_of("v")}))
    assert(many[1] == summarize(slice(t, 2, 4), "k", {"n": count(), "s": sum_of("v")}))
    let joined be summarize(flatten(many), "k", {"n": sum_of("n"), "s": sum_of("s")})
    let whole be summarize(t, "k", {"n": count(), "s": sum_of("v")})
    assert(joined == whole)
    assert_eq(length(joined), 2)

test "uint32_reads_positive_and_int32_stays_signed"
    require file.read("engine/crates/synsema-runtime/tests/fixtures/uint32.parquet")
    require file.read("engine/crates/synsema-runtime/tests/fixtures/int32_signed.parquet")
    let u be parquet_read(read_file_bytes("engine/crates/synsema-runtime/tests/fixtures/uint32.parquet"))
    let n be parquet_read(read_file_bytes("engine/crates/synsema-runtime/tests/fixtures/int32_signed.parquet"))
    assert_eq(text([u[0].u, u[1].u, u[2].u, u[3].u]), "[1, 2147483648, 4294967295, nothing]")
    assert_eq(text([n[0].n, n[1].n, n[2].n, n[3].n]), "[-1, -2147483648, 5, nothing]")
    assert_eq(type_of(u[1].u), "number")
    assert_eq(type_of(n[0].n), "number")
