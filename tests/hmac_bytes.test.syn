-- Gemelo de hmac_bytes.rs (v0.6.68, migas §4): HB1/HB2/HB4/B4/A2/M1/M2 — bytes crudos, vectores
-- RFC 4231, bits de 64 bits, secretos en headers sin forma impresa.
-- Correr con: synsema test tests/hmac_bytes.test.syn

require net("127.0.0.1")

let SPEC be "5031fe3d989c6d1537a013fa6e739da23463fdaec3b70137d828e36ace221bd0"

task expect_error(f, needle)
    let ok be false
    try
        f()
    recover e
        set ok to true
        assert(contains(e, needle))
    assert(ok)

test "hmac_with_bytes_uses_the_raw_bytes_and_text_is_unchanged"
    assert_eq(hex(hmac("data", "key", "sha256")), "0x" + SPEC)
    assert_eq(hex(hmac(bytes("data"), bytes("key"), "sha256")), "0x" + SPEC)
    assert_eq(hex(hmac(bytes("data"), "key", "sha256")), "0x" + SPEC)
    assert_eq(hex(hmac("data", bytes("key"), "sha256")), "0x" + SPEC)
    assert_eq(hex(hmac("data", "key")), "0x" + SPEC)
    assert_eq(hmac_sha256(bytes("data"), bytes("key")), SPEC)

test "rfc_4231_vectors_with_binary_keys"
    -- Caso 1: clave 0x0b × 20. Caso 6: clave 0xaa × 131 (más larga que el bloque).
    let k1 be bytes("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "hex")
    assert_eq(hex(hmac("Hi There", k1, "sha256")), "0xb0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    assert_eq(hex(hmac(bytes("Hi There"), k1, "sha512")), "0x87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    let k6 be bytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "hex")
    assert_eq(hex(hmac("Test Using Larger Than Block-Size Key - Hash Key First", k6, "sha256")), "0x60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")

test "verify_hmac_and_constant_time_eq_with_bytes"
    let mac be hmac(bytes("data"), bytes("key"))
    assert_eq(verify_hmac(bytes("data"), mac, bytes("key")), true)
    assert_eq(verify_hmac("data", SPEC, "key"), true)
    assert_eq(verify_hmac("data", "sha256=" + SPEC, bytes("key")), true)
    assert_eq(verify_hmac(bytes("data"), mac, bytes("other")), false)
    assert_eq(verify_hmac("data", "not a signature", "key"), false)
    assert_eq(constant_time_eq(bytes("ab"), "ab"), true)
    assert_eq(constant_time_eq(bytes("ab"), bytes("ac")), false)

test "a_type_that_is_not_text_bytes_or_secret_is_an_error"
    expect_error(() => hmac(123, "key"), "hmac: data must be text, bytes or a secret, got number")
    expect_error(() => hmac("data", [1, 2]), "hmac: key must be text, bytes or a secret, got list")
    expect_error(() => hmac("data", "key", 256), "hmac: algo must be text")
    expect_error(() => verify_hmac("data", 5, "key"), "verify_hmac: signature must be text (hex or base64) or bytes, got number")
    expect_error(() => verify_hmac("data", "00", nothing), "verify_hmac: key must be text, bytes or a secret, got nothing")
    expect_error(() => hmac_sha256(true, "k"), "hmac_sha256: data must be text, bytes or a secret, got bool")
    expect_error(() => constant_time_eq(1, 1), "constant_time_eq: a must be text, bytes or a secret, got number")

test "verify_hmac_with_a_missing_signature_is_false"
    assert_eq(verify_hmac("data", nothing, "key"), false)
    let h be {}
    assert_eq(verify_hmac("data", get(h, "x-signature"), as_secret("key")), false)

test "sigv4_chain_from_a_secret_key"
    let key be as_secret("wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
    let k_date be hmac("20150830", "AWS4" + key)
    let k_signing be hmac("aws4_request", hmac("iam", hmac("us-east-1", k_date)))
    let plain be hmac("aws4_request", hmac("iam", hmac("us-east-1", hmac("20150830", "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"))))
    assert_eq(hex(k_signing) == hex(plain), true)
    assert_eq(hex(k_signing), "0xc4afb1cc5771d871763a393e44b703571b55cc28424d1a5e86da6ed3c154a4b9")

test "bearer_headers_and_query_refuse_printed_forms"
    expect_error(() => bearer(nothing), "bearer: the token is nothing")
    expect_error(() => bearer(bytes("t")), "bearer: the token must be text or a secret, got bytes")
    expect_error(() => bearer(123), "bearer: the token must be text or a secret, got number")
    expect_error(() => bearer(as_secret(bytes("ffff", "hex"))), "holds bytes that are not UTF-8")
    expect_error(() => fetch("http://127.0.0.1:9/", {"headers": {"X-Key": nothing}}), "fetch: header \"X-Key\" is nothing")
    expect_error(() => http_get("http://127.0.0.1:9/", {"X-Raw": bytes("a")}), "http_get: header \"X-Raw\" must be text, a number, a bool or a secret, got bytes")
    expect_error(() => http_get("http://127.0.0.1:9/", nothing, {"token": as_secret("s")}), "query parameter \"token\" is secret(sealed), made by the program")
    expect_error(() => http_post("http://127.0.0.1:9/", {"client_secret": as_secret("s")}), "http_post: the body is secret(sealed), made by the program")
    expect_error(() => fetch("http://127.0.0.1:9/", {"method": "POST", "body": [1, {"k": as_secret("s")}]}), "fetch: the body is secret(sealed), made by the program")
    assert_eq(text(bearer("abc")), "secret(bearer)")
    assert_eq(text(bearer(as_secret("abc"))), "secret(sealed)")

test "basic_builds_the_rfc_7617_header_from_a_secret"
    let b be basic("Aladdin", as_secret("open sesame", "PASS"))
    assert_eq(text(b), "secret(PASS)")
    assert_eq(b == as_secret("Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="), true)
    assert_eq(basic("Aladdin", "open sesame") == as_secret("Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="), true)
    expect_error(() => basic("a:b", "p"), "basic: the user cannot contain ':'")
    expect_error(() => basic("u", nothing), "basic: the password is nothing")
    expect_error(() => basic("u", bytes("p")), "basic: the password must be text or a secret, got bytes")
    expect_error(() => basic(nothing, "p"), "basic: the user is nothing")

test "oauth_basic_form_encodes_before_base64"
    let b be oauth_basic("my app", as_secret("a+b/c=", "CLIENT_SECRET"))
    assert_eq(text(b), "secret(CLIENT_SECRET)")
    assert_eq(b == as_secret("Basic " + "bXkrYXBwOmElMkJiJTJGYyUzRA=="), true)
    assert_eq(basic("my app", "a+b/c=") == as_secret("Basic bXkgYXBwOmErYi9jPQ=="), true)
    expect_error(() => oauth_basic("id", nothing), "oauth_basic: the client_secret is nothing")

test "a_template_hole_after_a_secret_is_still_a_template_hole"
    let tok be as_secret("abc", "TOK")
    let scopes be [1, 2]
    let t be `token={tok} scopes={scopes} none={nothing} n={3}`
    assert_eq(text(t), "secret(TOK)")
    assert_eq(t == as_secret(`token=abc scopes={scopes} none={nothing} n={3}`), true)
    task build(k, xs)
        give `k={k} xs={xs} tail`
    let u be build(tok, scopes)
    assert_eq(u == as_secret("k=abc xs=[1, 2] tail"), true)
    assert_eq(text(`plain {scopes}`), "plain [1, 2]")
    expect_error(() => as_secret("k") + [1], "Cannot add secret(")
    expect_error(() => print(`x={as_secret(bytes("ff", "hex"), "B")}`), "secret(B): it holds bytes that are not UTF-8")

test "bits_from_a_program"
    assert_eq(bit_xor(0x36, 0x5c), 106)
    assert_eq(bit_and(-1, 255), 255)
    assert_eq(bit_or(1, 6), 7)
    assert_eq(bit_not(0), -1)
    assert_eq(shl(1, 10), 1024)
    assert_eq(shr(-8, 1), -4)
    assert_eq(hex(xor_bytes(bytes("3636", "hex"), bytes("5c00", "hex"))), "0x6a36")
    expect_error(() => shl(1, 64), "shl: the shift must be between 0 and 63, got 64")
    expect_error(() => shr(1, -1), "between 0 and 63")
    expect_error(() => shl(1, 63), "does not fit in a 64-bit integer")
    expect_error(() => bit_xor(18446744073709551616, 1), "64-bit integers")
    expect_error(() => bit_and(1.5, 1), "integers, got a float")
    expect_error(() => xor_bytes(bytes("a"), bytes("bc")), "same length, got 1 and 2 bytes")
    expect_error(() => xor_bytes("a", bytes("b")), "bytes(text)")
