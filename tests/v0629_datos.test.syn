-- v0.6.29 data operations. The lineage test uses a separate file to isolate file-level state.

task expect_error(f, needle)
    let ok be false
    try
        f()
    recover e
        set ok to true
        assert(contains(e, needle))
    assert(ok)

test "reductions_missing_nan_ddof_decimal"
    assert_eq(text(std([1, 2, 3, 4])), "1.2909944487358056")
    assert_eq(text(std([1, 2, 3, 4], ddof = 0)), "1.118033988749895")
    assert_eq(text(var([1, 2, 3, 4])), "1.6666666666666667")
    assert_eq(text(mean([1.5d, 2.5d])), "2.0")
    assert_eq(text(median([1d, 2d, 4d, 8d])), "3")
    assert_eq(text(sum([0.1d, 0.2d])), "0.3")
    assert_eq(text(mean([1, nothing, 3])), "2.0")
    assert_eq(text(sum([1, nan])), "nan")
    assert_eq(text(min([nan, 3])), "nan")
    assert_eq(text(max([3, nan])), "nan")
    assert_eq(text(median([3, nothing, 1])), "2.0")
    assert_eq(quantile([1, 2, 3, 4], 0.5), 2.5)
    assert_eq(percentile([1, 2, 3, 4], 50), 2.5)
    assert_eq(text(round_to(2.675, 2)), "2.67")
    assert_eq(text(round_to(1.005d, 2)), "1.00")
    assert_eq(text(round_to(0.125, 2)), "0.12")
    expect_error(() => mean([nothing]), "every value is missing")
    expect_error(() => quantile([1], 50), "between 0 and 1")
    expect_error(() => sum([1], axis = 0), "axis applies to arrays")

test "arrays"
    let m be array([[1, 2], [3, 4]])
    assert_eq(text(sum(m, axis = 0)), "[4, 6]")
    assert_eq(text(sum(m, 1)), "[3, 7]")
    assert_eq(text(mean(m, axis = -1)), "[1.5, 3.5]")
    assert_eq(text(std(m, axis = 0, ddof = 0)), "[1, 1]")
    assert_eq(text(sqrt(array([4, 9]))), "[2, 3]")
    assert_eq(text(m ** 2), "[[1, 4], [9, 16]]")
    assert_eq(text(m // 3), "[[0, 0], [1, 1]]")
    assert_eq(length(m), 2)
    assert_eq(size(m), 4)
    assert_eq(text(slice(m, -1)), "[[3, 4]]")
    assert_eq(text(m[-1]), "[3, 4]")
    assert_eq(text(apply(array([1, 2, 3]), (x) => x * 10)), "[10, 20, 30]")
    assert_eq(text(where(array([1, 5, 2, 8]), (x) => x > 2)), "[5, 8]")
    assert_eq(text(abs(array([-1, 2]))), "[1, 2]")
    assert_eq(text(floor(array([1.5, -1.5]))), "[1, -2]")
    assert_eq(text(concat([array([1, 2]), array([3])])), "[1, 2, 3]")
    assert_eq(text(stack([array([1, 2]), array([3, 4])])), "[[1, 2], [3, 4]]")
    assert_eq(text(concat([array([[1], [2]]), array([[3], [4]])], axis = 1)), "[[1, 3], [2, 4]]")
    assert_eq(argmax([3, 9, 2]), 1)
    assert_eq(argmin(array([3, 9, 2])), 2)
    assert_eq(text(argmax(array([[1, 5], [7, 2]]), axis = 1)), "[1, 0]")
    assert_eq(text(cumsum([1, 2, 3])), "[1, 3, 6]")
    assert_eq(text(cumsum(array([1, 2, 3]))), "[1, 3, 6]")
    assert_eq(text(diff([1, 4, 9])), "[3, 5]")
    assert_eq(text(diff(array([1, 4, 9]))), "[3, 5]")
    expect_error(() => dot(array([[1]]), array([[1]])), "matmul")
    assert_eq(text(dot(array([1, 2]), array([3, 4]))), "11.0")

test "statistics_and_fitting"
    assert_eq(text(corr([1, 2, 3], [2, 4, 6])), "1.0")
    assert_eq(text(cov([1, 2, 3], [1, 2, 3])), "1.0")
    assert_eq(text(cov([1, 2, 3], [1, 2, 3], ddof = 0)), "0.6666666666666666")
    assert_eq(mode([1, 2, 2, 3]), 2)
    assert_eq(mode(["a", "b", "a"]), "a")
    let c be polyfit([0, 1, 2, 3], [1, 3, 5, 7], 1)
    assert_eq(text(round_to(c[0], 9)), "2.0")
    assert_eq(text(round_to(c[1], 9)), "1.0")
    assert_eq(text(round_to(polyval(c, 10), 6)), "21.0")
    let x be lstsq(array([[1, 0], [0, 1], [1, 1]]), array([1, 2, 3]))
    assert_eq(text(round_to(x[0], 9)), "1.0")
    assert_eq(text(round_to(x[1], 9)), "2.0")

test "csv_and_json_lines"
    assert_eq(text(csv_parse("a,b,c,d\n007,,2026-01-02,1.50\n", {"types": {"a": "int", "c": "date", "d": "decimal"}})), "[{a: 7, b: nothing, c: 2026-01-02, d: 1.50}]")
    assert_eq(text(csv_parse("a,b\n007,\n")), "[{a: \"007\", b: nothing}]")
    assert_eq(text(jsonl_decode(jsonl_encode([{"a": 1}, [2]]))), "[{a: 1}, [2]]")
    assert_eq(jsonl_decode("{\n", nothing), nothing)
    expect_error(() => csv_parse("a\nx\n", {"types": {"a": "int"}}), "line 2")

test "seeded_random_is_reproducible"
    let g be rng(42)
    let h be rng(42)
    assert_eq(g() == h(), true)
    assert_eq(random_normal(g) == random_normal(h), true)
    assert_eq(shuffle(rng(1), [1, 2, 3, 4, 5]) == shuffle(rng(1), [1, 2, 3, 4, 5]), true)
    let s be sample(rng(7), range(0, 100), 5)
    assert_eq(length(s), 5)
    assert_eq(length(unique(s)), 5)
    assert_eq(choice(rng(3), ["a"]), "a")
    let u be rng(9)
    let v be u()
    assert(v >= 0 and v < 1)
    expect_error(() => random(), "random")
    let a be rng(5)
    let b be rng(5)
    assert_eq(random(a) == random(b), true)
    assert_eq(random_int(a, 1, 6) == random_int(b, 1, 6), true)
    let k be random_int(rng(1), 1, 6)
    assert(k >= 1 and k <= 6)
    expect_error(() => random_int(rng(1), 1.5, 6), "integer")

test "dates_datetimes_durations"
    let d be date(2026, 1, 31)
    assert_eq(text(d), "2026-01-31")
    assert_eq(text(add_months(d, 1)), "2026-02-28")
    assert_eq(text(d + duration(days = 1)), "2026-02-01")
    assert_eq(text(date("2026-03-01") - d), "P29D")
    assert_eq(type_of(d), "date")
    let t be datetime("2026-03-29T01:30:00", "Europe/Madrid")
    assert_eq(text(t), "2026-03-29T01:30:00+01:00[Europe/Madrid]")
    assert_eq(text(t + duration(hours = 1)), "2026-03-29T03:30:00+02:00[Europe/Madrid]")
    assert_eq(text(to_timezone(t, "UTC")), "2026-03-29T00:30:00Z")
    assert_eq(text(truncate(t, "month")), "2026-03-01T00:00:00+01:00[Europe/Madrid]")
    assert_eq(date_parts(d).weekday, 6)
    assert_eq(text(date_range(date(2026, 1, 1), date(2026, 1, 3))), "[2026-01-01, 2026-01-02, 2026-01-03]")
    assert_eq(text(sort([date(2026, 2, 1), date(2026, 1, 1)])), "[2026-01-01, 2026-02-01]")
    assert_eq(text(in_units(duration(hours = 1, minutes = 30), "minutes")), "90.0")
    assert_eq(text(timestamp(datetime("1970-01-01T00:01:00Z"))), "60.0")
    assert_eq(datetime(60) == datetime("1970-01-01T00:01:00Z"), true)
    assert_eq(format_time(d, "%d/%m/%Y"), "31/01/2026")
    assert_eq(text(parse_time("2026-01-03", "%Y-%m-%d")), "1767398400.0")
    assert_eq(json_encode({"when": d}), "{\"when\": \"2026-01-31\"}")
    assert_eq(text(min([date(2026, 2, 1), date(2026, 1, 1)])), "2026-01-01")
    assert_eq(text(max([date(2026, 2, 1), date(2026, 1, 1)])), "2026-02-01")
    let noon be datetime("2026-03-28T12:00:00", "Europe/Madrid")
    assert_eq(text(add_days(noon, 1)), "2026-03-29T12:00:00+02:00[Europe/Madrid]")
    assert_eq(text(noon + duration(days = 1)), "2026-03-29T13:00:00+02:00[Europe/Madrid]")
    assert_eq(date_parts(0).weekday, 4)
    expect_error(() => std([1, 2, 3], 0), "ddof = 0")
    expect_error(() => datetime("2026-03-29T02:30:00", "Europe/Madrid"), "daylight-saving gap")
    expect_error(() => date(2026, 2, 30), "not a valid calendar date")
    expect_error(() => date(2026, 1, 1) + duration(hours = 1), "whole days")
    expect_error(() => datetime("2026-01-01T00:00:00", "Mars/Olympus"), "IANA")

test "tables"
    let rows be [{"r": "n", "m": 10}, {"r": "s", "m": 5}, {"r": "n", "m": 1}, {"r": "s", "m": nothing}]
    assert_eq(text(group_by(rows, "r")), "[{key: \"n\", items: [{r: \"n\", m: 10}, {r: \"n\", m: 1}]}, {key: \"s\", items: [{r: \"s\", m: 5}, {r: \"s\", m: nothing}]}]")
    assert_eq(text(summarize(rows, "r", {"total": sum_of("m"), "n": count(), "avg": mean_of("m"), "top": max_of("m")})), "[{r: \"n\", total: 11, n: 2, avg: 5.5, top: 10}, {r: \"s\", total: 5, n: 2, avg: 5.0, top: 5}]")
    assert_eq(text(count_by(rows, "r")), "[{key: \"n\", count: 2}, {key: \"s\", count: 2}]")
    assert_eq(text(count_by(["x", "y", "x"])), "[{key: \"x\", count: 2}, {key: \"y\", count: 1}]")
    assert_eq(text(group_by([1, 1.0, 2], (v) => v)), "[{key: 1, items: [1, 1.0]}, {key: 2, items: [2]}]")
    assert_eq(text(join([{"id": 1, "a": "x"}, {"id": 2, "a": "y"}], [{"id": 1, "a": "z"}], "id", "left")), "[{id: 1, a: \"x\", a_right: \"z\"}, {id: 2, a: \"y\", a_right: nothing}]")
    assert_eq(text(join([{"id": 1}], [{"id": 1, "v": 2}, {"id": 3, "v": 4}], "id", "outer")), "[{id: 1, v: 2}, {id: 3, v: 4}]")
    assert_eq(join(["a", "b"], "-"), "a-b")
    assert_eq(text(pivot([{"d": "lu", "p": "a", "v": 1}, {"d": "lu", "p": "b", "v": 2}, {"d": "ma", "p": "a", "v": 3}], "d", "p", "v")), "[{d: \"lu\", a: 1, b: 2}, {d: \"ma\", a: 3, b: nothing}]")
    expect_error(() => pivot([{"d": 1, "p": "a", "v": 1}, {"d": 1, "p": "a", "v": 2}], "d", "p", "v"), "pass agg")
    assert_eq(fill_missing([1, nothing], 0), [1, 0])
    assert_eq(text(drop_missing(rows, "m")), "[{r: \"n\", m: 10}, {r: \"s\", m: 5}, {r: \"n\", m: 1}]")
    assert_eq(text(fill_missing(rows, {"m": 0})[3]), "{r: \"s\", m: 0}")
    assert_eq(is_missing(nothing), true)
    assert_eq(text(fill_nan([nan, 1], 0)), "[0, 1]")

test "parquet_round_trip_and_polars_interop"
    require file.read("engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet")
    let rows be parquet_read(read_file_bytes("engine/crates/synsema-runtime/tests/fixtures/polars_1_44_zstd.parquet"))
    assert_eq(text(rows[0]), "{id: 1, name: \"a\", x: 1.5, ok: true, d: 2026-01-02, ts: 2026-01-02T03:04:05Z, amt: 1.50}")
    assert_eq(rows[2].id, nothing)
    assert_eq(rows[1].name, nothing)
    assert_eq(type_of(rows[0].d), "date")
    assert_eq(type_of(rows[0].amt), "decimal")
    assert_eq(parquet_read(parquet_write(rows)) == rows, true)
    assert_eq(parquet_read(parquet_write(rows, {"compression": "zstd"})) == rows, true)
    let mine be [{"n": 10 ** 18, "t": "hé", "b": bytes([1, 2]), "dec": 12.345d}, {"n": nothing, "t": "x", "b": nothing, "dec": 1d}]
    assert_eq(text(parquet_read(parquet_write(mine, {"compression": "gzip"}))), "[{n: 1000000000000000000, t: \"hé\", b: bytes(0102), dec: 12.345}, {n: nothing, t: \"x\", b: nothing, dec: 1.000}]")
    expect_error(() => parquet_write([{"a": 1}, {"a": "x"}]), "mixes")
    expect_error(() => parquet_write([{"a": [1]}]), "json_encode")
    expect_error(() => parquet_read(bytes("nope")), "not a Parquet file")

test "shape_cache_with_a_dictionary_row_in_between"
    let big be {"v": 100, "g": "D"}
    let i be 0
    while i < 40
        set big["k" + text(i)] to i
        set i to i + 1
    let t1 be [{"g": "a", "v": 1}, big, {"g": "b", "v": 2}, {"g": "c", "v": 3}]
    let t be t1 + t1 + t1
    task marca(r)
        set r.g to "X" + text(r.v)
        give r.g + "/" + text(r.v)
    let keys be ["a", "D", "b", "c", "a", "D", "b", "c", "a", "D", "b", "c"]
    let marked be ["X1/1", "X100/100", "X2/2", "X3/3", "X1/1", "X100/100", "X2/2", "X3/3", "X1/1", "X100/100", "X2/2", "X3/3"]
    assert_eq(apply(t, (r) => r.g), keys)
    assert_eq(apply(t, marca), marked)
    assert_eq(group_by(t, "g") |> apply((x) => x.key), ["a", "D", "b", "c"])
    assert_eq(summarize(t, "g", {"s": sum_of("v")}) |> apply((x) => [x.g, x.s]), [["a", 3], ["D", 300], ["b", 6], ["c", 9]])
    assert_eq(join(t1, [{"g": "b", "w": 1}, {"g": "c", "w": 2}], "g", "inner") |> apply((x) => [x.g, x.v, x.w]), [["b", 2, 1], ["c", 3, 2]])
    assert_eq(apply(csv_parse(csv_encode(t, {"headers": ["g", "v"]})), (r) => r.g), keys)
