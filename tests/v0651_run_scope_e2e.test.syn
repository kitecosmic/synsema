-- Gemelo de v0651_run_scope_e2e.rs (v0.6.68): los dos candidatos migran: son errores del motor
-- al armar al hijo de `run_program` (gateado por `require sandbox_run`), capturables con
-- try/recover con los mismos needles exactos que afirma el .rs.
-- QUEDA en Rust (el .rs tiene 9 tests; migran 2): el resto es contrato del HOST (RunScope,
-- aislamiento por corrida del proceso):
--   g1_3_the_shutdown_of_one_serve_does_not_drain_another_in_the_same_process: dos serve reales
--     en sockets y el shutdown() de cada corrida observado desde el host.
--   g1_3_a_parallel_map_worker_shuts_down_the_run_of_its_caller: serve real + RunResult de la corrida.
--   g1_2_exit_in_the_preamble_works_while_another_serve_listens: sockets + exit_code del proceso.
--   g1_1_a_run_beside_a_serve_is_not_a_serve: un run y un serve en el MISMO proceso (host), sockets.
--   g1_6_each_serve_keeps_its_own_host_ceiling: ServeOverrides (techo que sólo el host fija),
--     serve real y cron de pared.
--   b1_the_pool_lets_go_of_a_finished_run: pool de workers del proceso y borrado del .db por el host.
--   b1_a_failed_preamble_lets_go_of_its_server: el puerto queda libre tras la corrida (sockets).
-- El orden importa: los grants se acumulan para toda la corrida del archivo, y n4 suma 400
-- concesiones que tambien inflarían el hijo de n2; n2 va primero.
-- Correr con: synsema test tests/v0651_run_scope_e2e.test.syn

require sandbox_run

test "n2_a_child_command_line_that_does_not_fit_gets_an_engine_error"
    let label be join(apply(range(31000), (i) => "a"), "")
    let ok be false
    try
        run_program("print(1)", {"timeout": 5, "filename": label})
    recover e
        set ok to true
        assert(contains(e, "the child's command line would be"))
    assert(ok)

