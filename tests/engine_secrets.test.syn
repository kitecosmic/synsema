-- Gemelo de engine_secrets.rs (synsema-runtime/tests, secrets/env/.env) (v0.6.68).
-- Afirma como VALORES lo que el .rs observaba por el stdout de run_source: la redacción de un
-- secret es un valor (text(s) == "secret(NAME)", nunca el plaintext), el taint propaga en `+`
-- ("x"+s, s+"x", 200+s -> type "secret"), y as_secret sella con label `sealed` (o custom), es
-- idempotente, NO pide capability y el tipo equivocado da error capturable.
-- Los gates (secret/env/reveal, prefijo APP_*) se afirman con try/recover y el needle exacto
-- del .rs. Los requires van al tope del bloque (un require dentro de un task NO concede) y
-- cada test usa nombres de recurso únicos: los grants se acumulan entre bloques de la misma
-- corrida. Los valores de los secrets usan el default en-lenguaje (no leen .env ni environ).
-- QUEDA en Rust: cuatro pruebas de stdout del host siguen en Rust; los bloques
-- con sufijo _runner verifican valores y tipos del lenguaje, no el canal print.
-- Los demás QUEDA:
--   reveal_returns_plaintext_and_audits_without_value: setea SYNSEMA_AUDIT_DIR/SYNSEMA_ENV_FILE
--     (estado del proceso) y lee reveal.log del host.
--   reveal_scoped_only_grants_matching_name: ídem (audit log del host + env del proceso).
--   as_secret_bytes_reveal_returns_bytes: ídem (SYNSEMA_AUDIT_DIR del proceso).
--   surface6_blackboard_redacted: run_swarm_dump (la pizarra del swarm la maneja el host).
--   surface5_llm_given_secret_no_leak: run_with_llm con respuestas mock del host.
--   surfaces_serve_body_error_and_sse_no_leak: levanta serve real (TcpListener + sockets).
-- Correr con: synsema test tests/engine_secrets.test.syn

task expect_error(f, needle)
    let ok be false
    try
        f()
    recover e
        set ok to true
        assert(contains(e, needle))
    assert(ok)

test "surface1_print_text_and_taint_redacted_runner"
    require secret("API")
    let s be secret("API", "pLAIntext_CANARY_do_not_leak_42")
    -- la redacción es un valor: el plaintext nunca asoma.
    assert_eq(text(s), "secret(API)")
    assert_eq(contains(text(s), "pLAIntext_CANARY_do_not_leak_42"), false)
    -- taint propagado: "x"+s, s+"x", num+s -> todos `secret`.
    assert_eq(type_of("tok-" + s), "secret")
    assert_eq(type_of(s + "-end"), "secret")
    assert_eq(type_of(200 + s), "secret")
    assert_eq(text("tok-" + s), "secret(API)")

test "cap_secret_undeclared_errors"
    task f()
        let s be secret("NOPE", "x")
        give s
    expect_error(f, "not permitted")
    expect_error(f, "secret(\"NOPE\")")

test "cap_env_undeclared_errors"
    task f()
        let p be env("PORT", 8080)
        give p
    expect_error(f, "not permitted")

test "reveal_without_capability_errors"
    require secret("K")
    let s be secret("K", "v")
    task f()
        give reveal(s)
    expect_error(f, "reveal() not permitted")

test "prefix_capability_authorizes_only_matching"
    require secret("APP_*")
    -- APP_* autoriza APP_KEY...
    let ok_s be secret("APP_KEY", "v")
    assert_eq(text(ok_s), "secret(APP_KEY)")
    -- ...pero NO OTHER_X.
    task f()
        let bad be secret("OTHER_X", "v")
        give bad
    expect_error(f, "not permitted")

test "as_secret_seals_and_propagates_taint_runner"
    let s be as_secret("pLAIntext_CANARY_do_not_leak_42")
    -- redacción con label default `sealed`; el plaintext nunca asoma.
    assert_eq(text(s), "secret(sealed)")
    assert_eq(type_of(s), "secret")
    assert_eq(contains(text(s), "pLAIntext_CANARY_do_not_leak_42"), false)
    -- el taint propaga en `+` (pre sigue secret y sigue redactado).
    let pre be "tok-" + s
    assert_eq(type_of(pre), "secret")
    assert_eq(text(pre), "secret(sealed)")
    assert_eq(contains(text(pre), "pLAIntext_CANARY_do_not_leak_42"), false)

test "as_secret_label_idempotent_and_type_errors_runner"
    -- label custom en la redacción.
    assert_eq(text(as_secret("x", "user_key")), "secret(user_key)")
    -- idempotente: sellar dos veces no cambia el label.
    assert_eq(text(as_secret(as_secret("x", "user_key"))), "secret(user_key)")
    -- tipos no text/bytes -> error claro.
    task f()
        give as_secret(123)
    expect_error(f, "expects text or bytes")

test "as_secret_needs_no_capability_runner"
    -- as_secret es puro y FORTALECE: no exige require (a diferencia de secret()).
    let k be as_secret("pLAIntext_CANARY_do_not_leak_42")
    assert_eq(type_of(k), "secret")
    assert_eq(text(k), "secret(sealed)")
    assert_eq(contains(text(k), "pLAIntext_CANARY_do_not_leak_42"), false)
